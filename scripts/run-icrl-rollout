#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/icrl-rollout.mlpl"); printf '%s\n' "$output" | grep -Fqx 'PASS held-out frozen-policy ICRL rollout'
echo "Held-out actions/rewards/regret, growing context, frozen fingerprints, ablations, determinism, and budgets passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/adaptation/icrl_rollout.mlpl"
