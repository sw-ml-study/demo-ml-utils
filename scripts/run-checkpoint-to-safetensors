#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/checkpoint-to-safetensors.mlpl"); printf '%s\n' "$output" | grep -Fqx 'PASS checkpoint to Safetensors extraction'
echo "Exact output bytes/values, independent catalog/read-back, atomic preservation, no-execution, adversarial source, and resource-budget checks passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/checkpoint/to_safetensors.mlpl"
