#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/icl-comparison-ir.mlpl"); printf '%s\n' "$output" | grep -Fqx 'PASS ICL comparison IR'
echo "Schema, stable variants, context matrices, predictions, MSE/accuracy, fingerprints, provenance, determinism, and budgets passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/adaptation/icl_comparison_ir.mlpl"
