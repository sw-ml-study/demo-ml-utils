#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
mkdir -p "$repo_root/tmp"
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/safetensors-to-gguf.mlpl"); printf '%s\n' "$output" | grep -Fqx 'PASS self-validating Safetensors to GGUF writer'
echo "Internal exact-byte, catalog, selective-read, atomic-preservation, unsupported-type, and budget validation passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/conversion/safetensors_to_gguf.mlpl"
