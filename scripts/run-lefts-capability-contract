#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
version=$($mlpl --version)
printf '%s\n' "$version" | grep -Fq 'Commit:'
printf '%s\n' "$version" | sed -n '1,9p'
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/lefts-capability-contract.mlpl"); printf '%s\n' "$output" | grep -Fqx 'PASS bounded LEFTS capability contract'
$mlpl --source-dir "$repo_root" "$repo_root/demos/experiments/lefts_capabilities.mlpl"
