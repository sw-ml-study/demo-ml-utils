#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mode=${1:---check}; fixture_dir="$repo_root/fixtures/adaptation"; work_dir=$(mktemp -d "${TMPDIR:-/tmp}/adaptation-fixtures.XXXXXX"); trap 'rm -rf "$work_dir"' EXIT HUP INT TERM
printf '%s\n' '{"schema":"sw-ml-study.adaptation-dataset","version":1,"task":"two-feature-linear","feature_count":2,"train":{"ids":[101,102,103,104],"x":[0,0,1,0,0,1,1,1],"y":[1,3,4,6]},"context":{"ids":[201,202],"x":[-1,0,0,-1],"y":[-1,-2]},"evaluation":{"ids":[301,302,303],"x":[2,0,0,2,2,2],"y":[5,7,11]}}' > "$work_dir/tiny-regression.json"
case "$mode" in
  --write) mkdir -p "$fixture_dir"; cp "$work_dir/tiny-regression.json" "$fixture_dir/tiny-regression.json" ;;
  --check) [ -f "$fixture_dir/tiny-regression.json" ] && cmp -s "$work_dir/tiny-regression.json" "$fixture_dir/tiny-regression.json" || { echo "fixture drift: fixtures/adaptation/tiny-regression.json" >&2; exit 1; } ;;
  *) echo "usage: generate-adaptation-fixtures [--check|--write]" >&2; exit 2 ;;
esac
echo "PASS adaptation fixtures $mode"
