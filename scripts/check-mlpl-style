#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
formatter=${MLPL_FMT:-$repo_root/../sw-mlpl/scripts/mlpl-fmt.sh}

[ -x "$formatter" ] || {
  echo "MLPL formatter not executable: $formatter" >&2
  exit 1
}

git -C "$repo_root" ls-files -z '*.mlpl' |
  xargs -0 "$formatter" --check

missing=$(
  cd "$repo_root"
  awk '
    FNR == 1 { pending = 0 }
    /^def[[:space:]]/ { pending = 1; definition_line = FNR; next }
    pending && /^[[:space:]]*$/ { next }
    pending {
      if ($0 !~ /^[[:space:]]*"/) {
        print FILENAME ":" definition_line ": function is missing a docstring"
      }
      pending = 0
    }
  ' $(git ls-files '*.mlpl')
)

if [ -n "$missing" ]; then
  printf '%s\n' "$missing" >&2
  exit 1
fi

echo "PASS MLPL formatting and function docstrings"
