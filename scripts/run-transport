#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/transport.mlpl"); printf '%s\n' "$output" | grep -Fqx 'PASS visualization transport contract'
echo "Internal ordering, round-trip, schema, and transport budget validation passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/visualization/transport.mlpl"
