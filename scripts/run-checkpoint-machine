#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/checkpoint-machine.mlpl"); printf '%s\n' "$output" | grep -Fqx 'PASS restricted primitive pickle machine'
echo "Primitive graph goldens, no-execution evidence, dangerous opcode rejection, malformed-stack rejection, round-trip, and resource budgets passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/checkpoint/primitive_machine.mlpl"
