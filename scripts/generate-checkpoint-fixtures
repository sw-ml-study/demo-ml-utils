#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mode=${1:---check}; fixture_dir="$repo_root/fixtures/checkpoint"; work_dir=$(mktemp -d "${TMPDIR:-/tmp}/checkpoint-fixtures.XXXXXX"); trap 'rm -rf "$work_dir"' EXIT HUP INT TERM
u16() { value=$1; file=$2; i=0; while [ "$i" -lt 2 ]; do byte=$((value % 256)); printf "\\$(printf '%03o' "$byte")" >> "$file"; value=$((value / 256)); i=$((i + 1)); done; }
u32() { value=$1; file=$2; i=0; while [ "$i" -lt 4 ]; do byte=$((value % 256)); printf "\\$(printf '%03o' "$byte")" >> "$file"; value=$((value / 256)); i=$((i + 1)); done; }
make_zip() { output=$1; name=$2; payload=$3; flags=${4:-0}; method=${5:-0}; : > "$output"; name_len=${#name}; size=$(wc -c < "$payload" | tr -d ' '); printf 'PK\003\004' >> "$output"; u16 20 "$output"; u16 "$flags" "$output"; u16 "$method" "$output"; u16 0 "$output"; u16 0 "$output"; u32 0 "$output"; u32 "$size" "$output"; u32 "$size" "$output"; u16 "$name_len" "$output"; u16 0 "$output"; printf '%s' "$name" >> "$output"; cat "$payload" >> "$output"; central_offset=$(wc -c < "$output" | tr -d ' '); printf 'PK\001\002' >> "$output"; u16 20 "$output"; u16 20 "$output"; u16 "$flags" "$output"; u16 "$method" "$output"; u16 0 "$output"; u16 0 "$output"; u32 0 "$output"; u32 "$size" "$output"; u32 "$size" "$output"; u16 "$name_len" "$output"; u16 0 "$output"; u16 0 "$output"; u16 0 "$output"; u16 0 "$output"; u32 0 "$output"; u32 0 "$output"; printf '%s' "$name" >> "$output"; end=$(wc -c < "$output" | tr -d ' '); central_size=$((end-central_offset)); printf 'PK\005\006' >> "$output"; u16 0 "$output"; u16 0 "$output"; u16 1 "$output"; u16 1 "$output"; u32 "$central_size" "$output"; u32 "$central_offset" "$output"; u16 0 "$output"; }
make_duplicate() { output=$1; payload=$2; : > "$output"; name=data.pkl; name_len=8; size=$(wc -c < "$payload" | tr -d ' '); first_offset=0; entry=0; while [ "$entry" -lt 2 ]; do printf 'PK\003\004' >> "$output"; u16 20 "$output"; u16 0 "$output"; u16 0 "$output"; u16 0 "$output"; u16 0 "$output"; u32 0 "$output"; u32 "$size" "$output"; u32 "$size" "$output"; u16 "$name_len" "$output"; u16 0 "$output"; printf '%s' "$name" >> "$output"; cat "$payload" >> "$output"; entry=$((entry+1)); done; central_offset=$(wc -c < "$output" | tr -d ' '); second_offset=$((30+name_len+size)); entry=0; while [ "$entry" -lt 2 ]; do printf 'PK\001\002' >> "$output"; u16 20 "$output"; u16 20 "$output"; u16 0 "$output"; u16 0 "$output"; u16 0 "$output"; u16 0 "$output"; u32 0 "$output"; u32 "$size" "$output"; u32 "$size" "$output"; u16 "$name_len" "$output"; u16 0 "$output"; u16 0 "$output"; u16 0 "$output"; u16 0 "$output"; u32 0 "$output"; if [ "$entry" -eq 0 ]; then u32 "$first_offset" "$output"; else u32 "$second_offset" "$output"; fi; printf '%s' "$name" >> "$output"; entry=$((entry+1)); done; end=$(wc -c < "$output" | tr -d ' '); central_size=$((end-central_offset)); printf 'PK\005\006' >> "$output"; u16 0 "$output"; u16 0 "$output"; u16 2 "$output"; u16 2 "$output"; u32 "$central_size" "$output"; u32 "$central_offset" "$output"; u16 0 "$output"; }
make_tensor_zip() { output=$1; pickle=$2; storage=$3; : > "$output"; offsets=""; for member in data.pkl data/0; do offsets="$offsets $(wc -c < "$output" | tr -d ' ')"; if [ "$member" = data.pkl ]; then payload=$pickle; else payload=$storage; fi; name_len=${#member}; size=$(wc -c < "$payload" | tr -d ' '); printf 'PK\003\004' >> "$output"; u16 20 "$output"; u16 0 "$output"; u16 0 "$output"; u16 0 "$output"; u16 0 "$output"; u32 0 "$output"; u32 "$size" "$output"; u32 "$size" "$output"; u16 "$name_len" "$output"; u16 0 "$output"; printf '%s' "$member" >> "$output"; cat "$payload" >> "$output"; done; central_offset=$(wc -c < "$output" | tr -d ' '); set -- $offsets; for member in data.pkl data/0; do local_offset=$1; shift; if [ "$member" = data.pkl ]; then payload=$pickle; else payload=$storage; fi; name_len=${#member}; size=$(wc -c < "$payload" | tr -d ' '); printf 'PK\001\002' >> "$output"; u16 20 "$output"; u16 20 "$output"; u16 0 "$output"; u16 0 "$output"; u16 0 "$output"; u16 0 "$output"; u32 0 "$output"; u32 "$size" "$output"; u32 "$size" "$output"; u16 "$name_len" "$output"; u16 0 "$output"; u16 0 "$output"; u16 0 "$output"; u16 0 "$output"; u32 0 "$output"; u32 "$local_offset" "$output"; printf '%s' "$member" >> "$output"; done; end=$(wc -c < "$output" | tr -d ' '); central_size=$((end-central_offset)); printf 'PK\005\006' >> "$output"; u16 0 "$output"; u16 0 "$output"; u16 2 "$output"; u16 2 "$output"; u32 "$central_size" "$output"; u32 "$central_offset" "$output"; u16 0 "$output"; }
pstr() { text=$1; file=$2; printf 'X' >> "$file"; u32 "${#text}" "$file"; printf '%s' "$text" >> "$file"; }
make_tensor_pickle() { output=$1; storage_name=$2; dtype_name=$3; stored_length=$4; printf '\200\002}' > "$output"; pstr tensor_a "$output"; printf '}' >> "$output"; pstr storage "$output"; pstr "$storage_name" "$output"; printf 's' >> "$output"; pstr dtype "$output"; pstr "$dtype_name" "$output"; printf 's' >> "$output"; pstr shape "$output"; printf '](K\002K\002es' >> "$output"; pstr offset "$output"; printf 'K\000s' >> "$output"; pstr length "$output"; printf "K\\$(printf '%03o' "$stored_length")ss." >> "$output"; }
benign="$work_dir/benign.pkl"; printf '\200\002}q\000X\006\000\000\000weight]q\001(K\001K\002es.' > "$benign"
dangerous="$work_dir/dangerous.pkl"; printf '\200\002cos\012system\012.' > "$dangerous"
persist="$work_dir/persist.pkl"; printf '\200\002Pstorage\012.' > "$persist"
tensor="$work_dir/tensor.pkl"; make_tensor_pickle "$tensor" data/0 I16 8
tensor_bad_dtype="$work_dir/tensor-bad-dtype.pkl"; make_tensor_pickle "$tensor_bad_dtype" data/0 F32 16
tensor_bad_length="$work_dir/tensor-bad-length.pkl"; make_tensor_pickle "$tensor_bad_length" data/0 I16 7
tensor_missing_storage="$work_dir/tensor-missing-storage.pkl"; make_tensor_pickle "$tensor_missing_storage" data/9 I16 8
storage="$work_dir/storage.bin"; printf '\001\000\376\377\054\001\000\002' > "$storage"
make_zip "$work_dir/benign.pt" data.pkl "$benign"
make_zip "$work_dir/dangerous-global.pt" data.pkl "$dangerous"
make_zip "$work_dir/dangerous-persistence.pt" data.pkl "$persist"
make_zip "$work_dir/path-traversal.pt" ../data.pkl "$benign"
make_zip "$work_dir/encrypted.pt" data.pkl "$benign" 1 0
make_zip "$work_dir/compressed.pt" data.pkl "$benign" 0 8
make_duplicate "$work_dir/duplicate-member.pt" "$benign"
make_tensor_zip "$work_dir/tensor-metadata.pt" "$tensor" "$storage"
make_tensor_zip "$work_dir/tensor-bad-dtype.pt" "$tensor_bad_dtype" "$storage"
make_tensor_zip "$work_dir/tensor-bad-length.pt" "$tensor_bad_length" "$storage"
make_tensor_zip "$work_dir/tensor-missing-storage.pt" "$tensor_missing_storage" "$storage"
head -c 20 "$work_dir/benign.pt" > "$work_dir/truncated.pt"
case "$mode" in
  --write) mkdir -p "$fixture_dir"; for generated in "$work_dir"/*.pt; do cp "$generated" "$fixture_dir/$(basename -- "$generated")"; done ;;
  --check) [ -d "$fixture_dir" ] || { echo "checkpoint fixture directory missing; run scripts/generate-checkpoint-fixtures --write" >&2; exit 1; }; for generated in "$work_dir"/*.pt; do committed="$fixture_dir/$(basename -- "$generated")"; [ -f "$committed" ] && cmp -s "$generated" "$committed" || { echo "fixture drift: ${committed#"$repo_root"/}" >&2; exit 1; }; done; committed_count=$(find "$fixture_dir" -type f -name '*.pt' | wc -l | tr -d ' '); generated_count=$(find "$work_dir" -type f -name '*.pt' | wc -l | tr -d ' '); [ "$committed_count" -eq "$generated_count" ] || { echo "unexpected committed checkpoint fixture" >&2; exit 1; } ;;
  *) echo "usage: generate-checkpoint-fixtures [--check|--write]" >&2; exit 2 ;;
esac
echo "PASS checkpoint fixtures $mode"
