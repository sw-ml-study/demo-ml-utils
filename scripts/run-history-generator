#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/history-generator.mlpl"); printf '%s\n' "$output" | grep -Fqx 'PASS source bandit history generation'
echo "Source task trajectories, reward/regret summaries, diversity, held-out separation, determinism, and budgets passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/adaptation/history_generator.mlpl"
