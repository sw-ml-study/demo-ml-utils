#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/numeric-conversion.mlpl"); printf '%s\n' "$output" | grep -Fqx 'PASS numeric conversion and error goldens'
echo "Internal conversion, metric, round-trip, invalid-input, and budget validation passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/quantization/numeric_conversion.mlpl"
