#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$("$repo_root/scripts/select-mlpl")
output=$("$mlpl" --source-dir "$repo_root" "$repo_root/tests/trained-help-engram.mlpl")
printf '%s\n' "$output" | grep -Fqx 'PASS CPU-trained Engram help router'
"$mlpl" --source-dir "$repo_root" "$repo_root/demos/help/trained_engram.mlpl"
