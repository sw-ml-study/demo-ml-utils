#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl"); mkdir -p "$repo_root/tmp"; work_dir=$(mktemp -d "$repo_root/tmp/icl-acceptance.XXXXXX"); trap 'rm -rf "$work_dir"' EXIT HUP INT TERM
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/icl-acceptance.mlpl" -- "$work_dir/test-report.json"); printf '%s\n' "$output" | grep -Fqx 'PASS final ICL acceptance'
echo "Reproducibility, frozen state, hostile data, leakage, resource limits, and atomic preservation/read-back checks passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/adaptation/icl_acceptance.mlpl" -- "$work_dir/demo-report.json"
