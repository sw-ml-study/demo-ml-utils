#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/linear-fine-tune.mlpl"); printf '%s\n' "$output" | grep -Fqx 'PASS manual linear fine-tuning'
echo "Manual-gradient goldens, held-out improvement, fingerprint change, stopping evidence, learning-rate rejection, round-trip, and resource budgets passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/adaptation/linear_fine_tune.mlpl"
