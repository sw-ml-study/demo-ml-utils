#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl"); mkdir -p "$repo_root/tmp"; work_dir=$(mktemp -d "$repo_root/tmp/icrl-acceptance.XXXXXX"); trap 'rm -rf "$work_dir"' EXIT HUP INT TERM
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/icrl-acceptance.mlpl" -- "$work_dir/test-report.json"); printf '%s\n' "$output" | grep -Fqx 'PASS final ICRL acceptance'
echo "Determinism, frozen held-out state, history IR, hostile data, resource limits, and atomic preservation/read-back passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/adaptation/icrl_acceptance.mlpl" -- "$work_dir/demo-report.json"
