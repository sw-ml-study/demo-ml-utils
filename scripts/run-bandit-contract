#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/bandit-contract.mlpl"); printf '%s\n' "$output" | grep -Fqx 'PASS bandit history contract'
echo "Task separation, reward tapes, histories, cumulative reward/regret, non-ICRL labels, determinism, and budgets passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/adaptation/bandit_contract.mlpl"
