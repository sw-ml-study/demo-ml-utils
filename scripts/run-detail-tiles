#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/detail-tiles.mlpl"); printf '%s\n' "$output" | grep -Fqx 'PASS distribution and sampled-surface tiles'
echo "Internal cross-format golden, merge, sampling, round-trip, and budget validation passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/visualization/detail_tiles.mlpl"
