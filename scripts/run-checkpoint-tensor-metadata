#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/checkpoint-tensor-metadata.mlpl"); printf '%s\n' "$output" | grep -Fqx 'PASS declarative tensor storage recovery'
echo "Tensor descriptor goldens, storage-range arithmetic, no-payload evidence, adversarial schema/opcode cases, round-trip, and resource budgets passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/checkpoint/tensor_metadata.mlpl"
