#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
model=${GGUF_REAL_MODEL:-$repo_root/../demo-extensions/local-media/models/SmolLM2-135M-Instruct-Q8_0.gguf}
max_seconds=${GGUF_MAX_SECONDS:-30}
max_rss_kib=${GGUF_MAX_RSS_KIB:-131072}
local_model="$repo_root/tmp/gguf-real-array-acceptance.gguf"
output="$repo_root/tmp/gguf-real-array-acceptance.txt"
metrics="$repo_root/tmp/gguf-real-array-acceptance.metrics"

[ -f "$model" ] || { echo "SKIP real GGUF acceptance: model not found at $model" >&2; exit 77; }
mkdir -p "$repo_root/tmp"
trap 'rm -f "$local_model" "$output" "$metrics"' EXIT HUP INT TERM
cp "$model" "$local_model"
mlpl=$("$repo_root/scripts/select-mlpl")
start=$(date +%s)
ulimit -s 16384
set +e
/usr/bin/time -l -o "$metrics" "$mlpl" --source-dir "$repo_root" "$repo_root/probes/gguf-real-array-probe.mlpl" -- "$local_model" > "$output"
status=$?
set -e
[ "$status" -eq 0 ] || { echo "real GGUF probe failed with status $status" >&2; cat "$metrics" >&2; exit "$status"; }
elapsed=$(($(date +%s) - start))
peak_bytes=$(awk '/maximum resident set size/ { print $1 }' "$metrics")
[ -n "$peak_bytes" ] || { echo "SKIP real GGUF acceptance: maximum RSS metrics are unavailable" >&2; exit 77; }
peak=$((peak_bytes / 1024))

grep -Fq 'architecture: llama' "$output"
grep -Fq 'array_elements: 147209' "$output"
grep -Fq 'catalog_bytes: 1786144' "$output"
grep -Fq 'tensors: 272' "$output"
[ "$elapsed" -le "$max_seconds" ] || { echo "real GGUF latency budget exceeded: ${elapsed}s > ${max_seconds}s" >&2; exit 1; }
[ "$peak" -le "$max_rss_kib" ] || { echo "real GGUF RSS budget exceeded: ${peak} KiB > ${max_rss_kib} KiB" >&2; exit 1; }

echo "DEMO: stack-safe real GGUF metadata-array acceptance"
echo "Scenario: reach the SmolLM2 llama.cpp tensor directory after skipping 147,209 unretained tokenizer-array values."
echo "Native boundary: bounded range reads and process RSS sampling; MLPL owns framing, cursor movement, budgets, and tensor descriptors."
echo "Budgets: 16 MiB process stack, ${max_seconds}s latency, ${max_rss_kib} KiB peak RSS, 64 MiB catalog ceiling, 4 KiB string lookahead, and 64 KiB numeric chunks."
cat "$output"
echo "Evidence: elapsed_seconds=$elapsed peak_rss_kib=$peak measurement=time-l"
echo "Interpretation: the parser keeps constant call depth and retains no tokenizer payloads, but must also satisfy the RSS ceiling; increasing the applet stack or memory budget is not acceptance."
