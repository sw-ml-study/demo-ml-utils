#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
"$repo_root/scripts/generate-gguf-fixtures" --check >/dev/null
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/gguf-statistics.mlpl"); printf '%s\n' "$output" | grep -Fqx 'PASS GGUF bounded mergeable statistics'
echo "Internal direct/chunked/sample/partition merge parity and fail-closed budget validation passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/gguf/statistics.mlpl"
