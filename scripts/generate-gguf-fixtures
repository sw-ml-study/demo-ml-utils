#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mode=${1:---check}
fixture_dir="$repo_root/fixtures/gguf"
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/gguf-fixtures.XXXXXX")
trap 'rm -rf "$work_dir"' EXIT HUP INT TERM

u32() { value=$1; file=$2; i=0; while [ "$i" -lt 4 ]; do byte=$((value % 256)); printf "\\$(printf '%03o' "$byte")" >> "$file"; value=$((value / 256)); i=$((i + 1)); done; }
u64() { value=$1; file=$2; i=0; while [ "$i" -lt 8 ]; do byte=$((value % 256)); printf "\\$(printf '%03o' "$byte")" >> "$file"; value=$((value / 256)); i=$((i + 1)); done; }
string() { text_value=$1; file=$2; text_length=${#text_value}; u64 "$text_length" "$file"; printf '%s' "$text_value" >> "$file"; }
array_header() { element_type=$1; length=$2; file=$3; u32 9 "$file"; u32 "$element_type" "$file"; u64 "$length" "$file"; }

write_valid() {
  file=$1; offset=${2:-0}; type=${3:-0}; alignment=${4:-32}
  : > "$file"; printf 'GGUF' >> "$file"; u32 3 "$file"; u64 1 "$file"; u64 2 "$file"
  string general.architecture "$file"; u32 8 "$file"; string demo "$file"
  string general.alignment "$file"; u32 4 "$file"; u32 "$alignment" "$file"
  string weight "$file"; u32 1 "$file"; u64 4 "$file"; u32 "$type" "$file"; u64 "$offset" "$file"
  bytes=$(wc -c < "$file" | tr -d ' '); pad=$(((alignment - (bytes % alignment)) % alignment)); i=0
  while [ "$i" -lt "$pad" ]; do printf '\000' >> "$file"; i=$((i + 1)); done
  i=0; while [ "$i" -lt 16 ]; do printf '\000' >> "$file"; i=$((i + 1)); done
}

write_valid "$work_dir/valid-small.gguf"
write_valid "$work_dir/misaligned-offset.gguf" 1
write_valid "$work_dir/unsupported-tensor-type.gguf" 0 4
write_valid "$work_dir/invalid-alignment.gguf" 0 0 7

# llama.cpp-style tokenizer metadata arrays followed by one tensor descriptor.
file="$work_dir/valid-metadata-arrays.gguf"; : > "$file"; printf 'GGUF' >> "$file"; u32 3 "$file"; u64 1 "$file"; u64 7 "$file"
string general.architecture "$file"; u32 8 "$file"; string llama "$file"
string tokenizer.ggml.tokens "$file"; array_header 8 3 "$file"; string '<s>' "$file"; string hello "$file"; string ' world' "$file"
string tokenizer.ggml.scores "$file"; array_header 6 3 "$file"; printf '\000\000\200\077\000\000\000\077\000\000\200\277' >> "$file"
string tokenizer.ggml.token_type "$file"; array_header 5 3 "$file"; u32 1 "$file"; u32 2 "$file"; u32 4294967295 "$file"
string custom.f32 "$file"; u32 6 "$file"; printf '\000\000\200\077' >> "$file"
string custom.i64 "$file"; u32 11 "$file"; printf '\377\377\377\377\377\377\377\377' >> "$file"
string custom.f64 "$file"; u32 12 "$file"; printf '\000\000\000\000\000\000\360\077' >> "$file"
string weight "$file"; u32 1 "$file"; u64 4 "$file"; u32 0 "$file"; u64 0 "$file"
bytes=$(wc -c < "$file" | tr -d ' '); pad=$(((32 - (bytes % 32)) % 32)); i=0; while [ "$i" -lt "$pad" ]; do printf '\000' >> "$file"; i=$((i + 1)); done; i=0; while [ "$i" -lt 16 ]; do printf '\000' >> "$file"; i=$((i + 1)); done

file="$work_dir/nested-metadata-array.gguf"; : > "$file"; printf 'GGUF' >> "$file"; u32 3 "$file"; u64 0 "$file"; u64 1 "$file"; string general.architecture "$file"; array_header 9 0 "$file"
file="$work_dir/truncated-metadata-array.gguf"; : > "$file"; printf 'GGUF' >> "$file"; u32 3 "$file"; u64 0 "$file"; u64 1 "$file"; string general.architecture "$file"; array_header 8 1 "$file"
cp "$work_dir/valid-small.gguf" "$work_dir/bad-magic.gguf"; printf 'BAD!' | dd of="$work_dir/bad-magic.gguf" bs=1 count=4 conv=notrunc 2>/dev/null
dd if="$work_dir/valid-small.gguf" of="$work_dir/truncated.gguf" bs=1 count=20 2>/dev/null
: > "$work_dir/unsupported-version.gguf"; printf 'GGUF' >> "$work_dir/unsupported-version.gguf"; u32 2 "$work_dir/unsupported-version.gguf"; u64 0 "$work_dir/unsupported-version.gguf"; u64 0 "$work_dir/unsupported-version.gguf"
: > "$work_dir/excessive-count.gguf"; printf 'GGUF' >> "$work_dir/excessive-count.gguf"; u32 3 "$work_dir/excessive-count.gguf"; u64 5 "$work_dir/excessive-count.gguf"; u64 0 "$work_dir/excessive-count.gguf"
: > "$work_dir/unsupported-metadata-type.gguf"; printf 'GGUF' >> "$work_dir/unsupported-metadata-type.gguf"; u32 3 "$work_dir/unsupported-metadata-type.gguf"; u64 0 "$work_dir/unsupported-metadata-type.gguf"; u64 1 "$work_dir/unsupported-metadata-type.gguf"; string general.architecture "$work_dir/unsupported-metadata-type.gguf"; u32 9 "$work_dir/unsupported-metadata-type.gguf"

file="$work_dir/valid-catalog.gguf"; : > "$file"; printf 'GGUF' >> "$file"; u32 3 "$file"; u64 4 "$file"; u64 4 "$file"
string general.architecture "$file"; u32 8 "$file"; string demo "$file"
string general.alignment "$file"; u32 4 "$file"; u32 32 "$file"
string general.file_type "$file"; u32 4 "$file"; u32 7 "$file"
string custom.enabled "$file"; u32 7 "$file"; printf '\001' >> "$file"
string alpha "$file"; u32 1 "$file"; u64 4 "$file"; u32 0 "$file"; u64 0 "$file"
string quant "$file"; u32 1 "$file"; u64 32 "$file"; u32 8 "$file"; u64 32 "$file"
string ints "$file"; u32 1 "$file"; u64 4 "$file"; u32 25 "$file"; u64 96 "$file"
string bytes "$file"; u32 1 "$file"; u64 4 "$file"; u32 24 "$file"; u64 128 "$file"
bytes=$(wc -c < "$file" | tr -d ' '); pad=$(((32 - (bytes % 32)) % 32)); i=0; while [ "$i" -lt "$pad" ]; do printf '\000' >> "$file"; i=$((i + 1)); done
i=0; while [ "$i" -lt 32 ]; do printf '\000' >> "$file"; i=$((i + 1)); done
# One ggml block_q8_0: binary16 scale 0.5 (0x3800), then signed quants -16..15.
printf '\000\070\360\361\362\363\364\365\366\367\370\371\372\373\374\375\376\377\000\001\002\003\004\005\006\007\010\011\012\013\014\015\016\017' >> "$file"
i=0; while [ "$i" -lt 30 ]; do printf '\000' >> "$file"; i=$((i + 1)); done
printf '\000\200\376\377\377\177\052\000' >> "$file"
i=0; while [ "$i" -lt 24 ]; do printf '\000' >> "$file"; i=$((i + 1)); done
printf '\200\377\000\177' >> "$file"

file="$work_dir/duplicate-metadata.gguf"; : > "$file"; printf 'GGUF' >> "$file"; u32 3 "$file"; u64 0 "$file"; u64 2 "$file"; string general.architecture "$file"; u32 8 "$file"; string demo "$file"; string general.architecture "$file"; u32 8 "$file"; string again "$file"
file="$work_dir/duplicate-tensor.gguf"; : > "$file"; printf 'GGUF' >> "$file"; u32 3 "$file"; u64 2 "$file"; u64 1 "$file"; string general.architecture "$file"; u32 8 "$file"; string demo "$file"; string same "$file"; u32 1 "$file"; u64 1 "$file"; u32 0 "$file"; u64 0 "$file"; string same "$file"; u32 1 "$file"; u64 1 "$file"; u32 0 "$file"; u64 32 "$file"
file="$work_dir/overlapping-known.gguf"; : > "$file"; printf 'GGUF' >> "$file"; u32 3 "$file"; u64 2 "$file"; u64 1 "$file"; string general.architecture "$file"; u32 8 "$file"; string demo "$file"; string first "$file"; u32 1 "$file"; u64 16 "$file"; u32 0 "$file"; u64 0 "$file"; string second "$file"; u32 1 "$file"; u64 4 "$file"; u32 0 "$file"; u64 32 "$file"; bytes=$(wc -c < "$file" | tr -d ' '); pad=$(((32 - (bytes % 32)) % 32)); i=0; while [ "$i" -lt "$pad" ]; do printf '\000' >> "$file"; i=$((i + 1)); done; i=0; while [ "$i" -lt 48 ]; do printf '\000' >> "$file"; i=$((i + 1)); done
file="$work_dir/partial-q8-block.gguf"; : > "$file"; printf 'GGUF' >> "$file"; u32 3 "$file"; u64 1 "$file"; u64 1 "$file"; string general.architecture "$file"; u32 8 "$file"; string demo "$file"; string broken "$file"; u32 1 "$file"; u64 33 "$file"; u32 8 "$file"; u64 0 "$file"

case "$mode" in
  --write) mkdir -p "$fixture_dir"; for generated in "$work_dir"/*; do cp "$generated" "$fixture_dir/$(basename -- "$generated")"; done ;;
  --check) [ -d "$fixture_dir" ] || { echo "GGUF fixture directory missing" >&2; exit 1; }; for generated in "$work_dir"/*; do committed="$fixture_dir/$(basename -- "$generated")"; [ -f "$committed" ] && cmp -s "$generated" "$committed" || { echo "GGUF fixture drift: ${committed#"$repo_root"/}" >&2; exit 1; }; done; committed_count=$(find "$fixture_dir" -type f -name '*.gguf' | wc -l | tr -d ' '); generated_count=$(find "$work_dir" -type f | wc -l | tr -d ' '); [ "$committed_count" -eq "$generated_count" ] || { echo "unexpected committed GGUF fixture" >&2; exit 1; } ;;
  *) echo "usage: generate-gguf-fixtures [--check|--write]" >&2; exit 2 ;;
esac
echo "PASS GGUF fixtures $mode"
