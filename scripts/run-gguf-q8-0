#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
"$repo_root/scripts/generate-gguf-fixtures" --check >/dev/null
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/gguf-q8-0.mlpl"); printf '%s\n' "$output" | grep -Fqx 'PASS GGUF Q8_0 golden decode'
echo "Internal Q8_0 golden/oracle and fail-closed budget validation passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/gguf/q8_0.mlpl"
