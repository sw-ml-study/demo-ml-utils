#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
python_bin=${PYTHON:-$(command -v python3 || true)}
[ -n "$python_bin" ] && [ -x "$python_bin" ] || { echo "SKIP external oracle: set PYTHON to an absolute Python 3 executable" >&2; exit 77; }
mkdir -p "$repo_root/tmp"; work_dir=$(mktemp -d "$repo_root/tmp/external-oracle.XXXXXX"); trap 'rm -rf "$work_dir"' EXIT HUP INT TERM
artifact="$work_dir/converted.gguf"; generated=$($mlpl --source-dir "$repo_root" "$repo_root/probes/external_oracle_artifact.mlpl" -- "$artifact"); printf '%s\n' "$generated" | grep -Fqx 'PASS oracle artifact generated and self-validated'
observed=$($python_bin "$repo_root/scripts/oracles/inspect_single_gguf.py" "$artifact")
expected='{"architecture":"demo","file_bytes":166,"metadata":2,"name":"i16_values","offset":0,"sha256":"884f3fcbef283b2848da263b3bfe5da375f3843fad66ec7afc1ea25ee081062f","shape":[3],"tensors":1,"type_id":25,"values":[-32768,-2,32767],"version":3}'
[ "$observed" = "$expected" ] || { echo "external oracle mismatch" >&2; echo "observed: $observed" >&2; exit 1; }
llama_quantize=${LLAMA_QUANTIZE:-$(command -v llama-quantize || true)}; if [ -n "$llama_quantize" ] && [ -x "$llama_quantize" ]; then llama_status="available at $llama_quantize (not applicable to the signed-integer teaching artifact)"; else llama_status="not found; set LLAMA_QUANTIZE to record availability"; fi
echo "DEMO: explicit external oracle comparison"
echo "Scenario: have MLPL write and self-validate a tiny I16 GGUF, then independently parse its bytes with a pinned standard-library Python adapter."
echo "Native boundary: MLPL bounded reads/atomic write; the opt-in Python process is explicitly external and performs an independent structural/value/hash comparison."
echo "Budgets: one tensor, two metadata fields, 166 artifact bytes, three decoded values, one external process, no download; temporary files are scheduled for cleanup."
echo "Observed oracle record: $observed"
echo "Optional llama.cpp adapter: $llama_status"
echo "Interpretation: two implementations agree on version, metadata, tensor name/type/shape/offset, decoded values, file length, and complete-file SHA-256. llama-quantize is only capability-detected because this I16 teaching artifact is not an eligible model quantization input."
