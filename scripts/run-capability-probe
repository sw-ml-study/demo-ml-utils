#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mlpl=$("$repo_root/scripts/select-mlpl")
probe_file="$repo_root/.capability-probe.bin"
trap 'rm -f "$probe_file"' EXIT HUP INT TERM

version=$($mlpl --version)
echo "DEMO: executable binary-format capability contract"
echo "Scenario: prove which generic primitives downstream artifact demos may rely on, including their failure boundaries."
echo "Native boundary: the runtime provides generic I/O, JSON, bit, and record operations; MLPL assertions verify exact behavior without claiming format parsing."
echo "Budgets: a 4-byte probe file, exact range/EOF cases, JSON byte/depth/element limits, and the f64 exact-integer boundary at 2^53."
echo "Representative selected binary:"
printf '%s\n' "$version" | sed -n '1,9p'

output=$($mlpl --source-dir "$repo_root" "$repo_root/probes/capabilities.mlpl")
printf '%s\n' "$output"

for expected in \
  'CAPABILITY byte_io=whole-file-and-bounded-range-result-array' \
  'CAPABILITY file_size=metadata-result' \
  'CAPABILITY bit_ops=unsigned-exact-below-2^53' \
  'CAPABILITY json=depth-byte-element-budgeted-result-duplicate-safe' \
  'CAPABILITY record_keys=deterministic-sorted-string-list' \
  'LIMITATION typed_byte_arrays=absent'
do
  printf '%s\n' "$output" | grep -Fqx "$expected"
done

if $mlpl --source-dir "$repo_root" "$repo_root/probes/bit-domain-error.mlpl" >/dev/null 2>&1; then
  echo "bit operations accepted an operand at 2^53" >&2
  exit 1
fi

if $mlpl --source-dir "$repo_root" "$repo_root/probes/range-domain-error.mlpl" >/dev/null 2>&1; then
  echo "bounded byte reads accepted a negative offset" >&2
  exit 1
fi

[ ! -e "$probe_file" ] || {
  echo "capability probe did not clean up its byte fixture" >&2
  exit 1
}

echo "Interpretation: bounded range I/O and decode budgets are available; bytes remain f64-backed arrays, so typed-byte and zero-copy optimizations are still absent."
echo "Internal negative checks also rejected a 2^53 bit operand and a negative range offset."
