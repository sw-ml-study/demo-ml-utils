#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/distilled-policy.mlpl"); printf '%s\n' "$output" | grep -Fqx 'PASS distilled context policy'
echo "Offline loss, learned decisions, parameter updates, frozen artifact, held-out independence, determinism, and budgets passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/adaptation/distilled_policy.mlpl"
