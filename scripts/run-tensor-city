#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
"$repo_root/scripts/generate-safetensors-fixtures" --check >/dev/null; "$repo_root/scripts/generate-gguf-fixtures" --check >/dev/null
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/tensor-city.mlpl"); printf '%s\n' "$output" | grep -Fqx 'PASS deterministic tensor-city layout'
echo "Internal cross-format golden layout, ordering, collision, round-trip, and budget validation passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/visualization/model_scene.mlpl"
