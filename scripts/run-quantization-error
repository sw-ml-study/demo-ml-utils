#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/quantization-error-tiles.mlpl"); printf '%s\n' "$output" | grep -Fqx 'PASS Q8_0 quantization error tiles'
echo "Internal block, metric, zero-vector, round-trip, and budget validation passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/visualization/quantization_error.mlpl"
