#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
"$repo_root/scripts/generate-safetensors-fixtures" --check >/dev/null; "$repo_root/scripts/generate-gguf-fixtures" --check >/dev/null
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/scene-tile-ir.mlpl"); printf '%s\n' "$output" | grep -Fqx 'PASS cross-format scene tile IR'
echo "Internal golden round-trip and fail-closed scene budget validation passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/visualization/scene_tiles.mlpl"
