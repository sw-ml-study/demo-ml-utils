#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/symmetric-roundtrip.mlpl"); printf '%s\n' "$output" | grep -Fqx 'PASS symmetric INT8 and Q8_0 round trips'
echo "Internal byte-golden, independent-decode, metric, zero-block, and budget validation passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/quantization/symmetric_roundtrip.mlpl"
