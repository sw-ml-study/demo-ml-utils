#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd); mlpl=$("$repo_root/scripts/select-mlpl")
output=$($mlpl --source-dir "$repo_root" "$repo_root/tests/icl-controls.mlpl"); printf '%s\n' "$output" | grep -Fqx 'PASS ICL context controls'
echo "Order, distractor, contradiction, truncation, empty-context, duplicate/leakage, frozen-state, and exhaustion controls passed."
$mlpl --source-dir "$repo_root" "$repo_root/demos/adaptation/icl_controls.mlpl"
