include "../src/checkpoint/checkpoint_to_safetensors.mlpl";
path=unwrap_or(list_get(args(),0),""); b={max_artifact_bytes:512,max_members:4,max_pickle_bytes:256,max_opcodes:96,max_strings:16,max_string_bytes:64,max_total_string_bytes:256,max_memo_entries:8,max_depth:8,max_iterations:96,max_output_bytes:32768,max_json_depth:8,max_json_elements:2048,max_stack:24,max_nodes:32,max_list_items:16,max_dict_items:32,max_tensors:4,max_rank:4,max_parameters:64,max_storage_bytes:128,max_total_storage_bytes:128,max_safetensors_header_bytes:256,max_safetensors_json_elements:256,max_output_file_bytes:512}; result=u:write_checkpoint_safetensors("fixtures/checkpoint/tensor-metadata.pt",path,b)?; if equal(result.values,[1,-2,300,512])*eq(result.file_bytes,80) { print("PASS checkpoint oracle artifact generated and self-validated"); ok(1) } else { err("checkpoint oracle artifact generation mismatch") }
