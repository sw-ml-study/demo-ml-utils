print("District/group codes:");
print(qv17.ir.tensor_columns.group_ids);
print("Dot-separated name hierarchy depths:");
print(qv17.ir.tensor_columns.name_depths);
print("Building x, z, and height columns:");
print({x: qv17.ir.tensor_columns.x,z: qv17.ir.tensor_columns.z,height: qv17.ir.tensor_columns.heights});
print("Representative stable ID:");
print(u:city_text(flatten(qv17.ir.tensor_columns.id_bytes),qv17.ir.tensor_columns.id_lengths,4,128));
print("Interpretation: quant is visibly tallest at height 33, the empty Safetensors tensor remains a height-1 building, districts cannot overlap in z, and renderers receive catalog-derived geometry rather than tensor payloads.");
