include "../../src/adaptation/acceptance.mlpl";
def u:acceptance_demo_path() {
  "Return the required output path.";
  unwrap_or(list_get(args(),0),"")
}
def u:dfb() {
  "Return acceptance demonstration budgets.";
  {max_examples_per_split:8,max_features:4,max_elements_per_split:32,max_total_examples:16,max_split_comparisons:64,max_abs_value:100,max_parameters:32,max_fingerprint_elements:32,max_fingerprint_bytes:512,max_dataset_bytes:2048,max_json_depth:12,max_json_elements:8192,max_output_bytes:65536,min_learning_rate:0.000001,max_learning_rate:1,max_steps:300,max_tolerance:1,max_iterations:300,max_abs_prediction:1000,max_gradient_norm:1000,max_abs_parameter:100,max_loss:10000,max_curve_points:301,max_adapter_elements:128,max_adapter_rank:2,max_base_parameters:32,max_adapter_parameters:32,max_parity_error:0.0000000001,max_atomic_bytes:65536}
}
path=u:acceptance_demo_path();
b=u:dfb();
full=u:linear_fine_tune("fixtures/adaptation/tiny-regression.json",[0,0,0],{learning_rate:0.2,max_steps:60,tolerance:0.000001},b)?;
low=u:low_rank_fine_tune("fixtures/adaptation/tiny-regression.json",reshape(fill([6],0),[2,3]),reshape([0.1,-0.1],[2,1]),reshape([0.5,0.5,0.5],[1,3]),{learning_rate:0.05,max_steps:200,tolerance:0.00001},b)?;
built=u:adaptation_curve_ir(full,low,b)?;
written=u:write_adaptation_report(path,built,b)?;
print("DEMO: bounded fine-tuning acceptance and atomic evidence");
print("Scenario: run dense and rank-one teaching trainers twice conceptually, reject hostile dataset/resource cases, then publish their shared evidence only after headless validation and verify the exact atomic result.");
print("Native boundary: bounded reads, numeric/matrix primitives, tagged JSON, atomic write/read-back, and path removal. MLPL work: training, leakage/malformed/non-finite validation, deterministic evidence, IR normalization, budgets, and semantic acceptance.");
print("Budgets: eight examples and four features per split; 300 iterations and 301 curve points; rank at most two; finite data/gradient/parameter/loss limits; 65536 IR, atomic-report, and decode bytes; JSON depth 12 and 8192 elements.");
print("Accepted run evidence:");
print({full_updates: full.report.updates,full_held_loss: full.report.evaluation.fine_tuned_loss,low_rank_updates: low.report.updates,low_rank_held_loss: low.report.evaluation.loss,low_rank_base_unchanged: equal(low.report.base_fingerprint,low.report.final_base_fingerprint),ir_bytes: built.utf8_bytes,atomic_bytes: written.bytes,atomic_write: written.atomic_write,self_validated: written.self_validated,path: written.path});
print("Adversarial matrix: split leakage, duplicate/malformed shapes and keys, non-finite and over-budget numeric data, insufficient iteration/curve/output/atomic limits, schema/version/alignment failures, and destination preservation are exercised by the acceptance test before this narrative runs.");
print("Interpretation: acceptance proves deterministic tiny-model evidence and fail-closed bounded publication, not optimizer quality at scale, framework compatibility, GPU training, LLM fine-tuning, or statistical generalization beyond the fixed held-out examples.");
