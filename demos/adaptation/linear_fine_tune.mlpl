include "../../src/adaptation/linear_fine_tune.mlpl";
b={max_examples_per_split:8,max_features:4,max_elements_per_split:32,max_total_examples:16,max_split_comparisons:64,max_abs_value:100,max_parameters:16,max_fingerprint_elements:16,max_fingerprint_bytes:256,max_dataset_bytes:2048,max_json_depth:8,max_json_elements:2048,max_output_bytes:32768,min_learning_rate:0.000001,max_learning_rate:1,max_steps:100,max_tolerance:1,max_iterations:100,max_abs_prediction:1000,max_gradient_norm:1000,max_abs_parameter:100,max_loss:10000,max_curve_points:101}; config={learning_rate:0.2,max_steps:60,tolerance:0.000001}; trained=u:linear_fine_tune("fixtures/adaptation/tiny-regression.json",[0,0,0],config,b)?; r=trained.report; excessive_rejected=is_err(u:linear_fine_tune("fixtures/adaptation/tiny-regression.json",[0,0,0],{learning_rate:5,max_steps:10,tolerance:0},b));
print("DEMO: bounded manual-gradient linear fine-tuning"); print("Scenario: learn the hidden rule y = 1 + 2*x1 + 3*x2 from four training examples, starting from zero bias/weights, then predict three held-out points that were excluded by the adaptation-contract leakage check."); print("Native boundary: bounded dataset read, numeric array primitives, and generic tagged JSON. MLPL work: predictions, mean-squared loss, explicitly derived bias/weight gradients, batch-gradient updates, stopping decision, fingerprints, held-out evaluation, budgets, and report validation."); print("Budgets: 60 requested/100 maximum steps and iterations; learning rate 0.2 within [0.000001,1]; eight examples/four features per split; 16 parameters; prediction/gradient/parameter/loss ceilings; 101 curve points; 32768 report bytes and 2048 JSON elements.");
print("Parameter update evidence:"); print({initial: r.initial_parameters,final: r.final_parameters,target_rule_parameters:[1,2,3],initial_fingerprint: r.initial_fingerprint,final_fingerprint: r.final_fingerprint,updates: r.updates,stopping_reason: r.stopping_reason}); print("Selected training loss and gradient-norm trajectory:"); print({loss_steps:[0,1,5,10,30,60],losses:[take(r.train.losses,0,0),take(r.train.losses,0,1),take(r.train.losses,0,5),take(r.train.losses,0,10),take(r.train.losses,0,30),take(r.train.losses,0,60)],gradient_steps:[0,1,5,10,30,59],gradient_norms:[take(r.train.gradient_norms,0,0),take(r.train.gradient_norms,0,1),take(r.train.gradient_norms,0,5),take(r.train.gradient_norms,0,10),take(r.train.gradient_norms,0,30),take(r.train.gradient_norms,0,59)]}); print("Held-out comparison:"); print({targets: r.evaluation.targets,no_training_predictions: r.evaluation.baseline_predictions,no_training_mse: r.evaluation.baseline_loss,fine_tuned_predictions: r.evaluation.fine_tuned_predictions,fine_tuned_mse: r.evaluation.fine_tuned_loss,excessive_learning_rate_rejected: excessive_rejected,report_bytes: trained.utf8_bytes}); print("Interpretation: the zero-parameter baseline predicts zero and has MSE 65. Manual updates move all three parameters near the exact [1,2,3] rule and reduce held-out error by roughly four orders of magnitude. The run stops at its declared 60-step ceiling; an out-of-budget learning rate fails before changing parameters."); ok(1)
