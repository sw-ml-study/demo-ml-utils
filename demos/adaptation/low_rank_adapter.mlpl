include "../../src/adaptation/low_rank_adapter.mlpl";
b={max_examples_per_split:8,max_features:4,max_elements_per_split:32,max_total_examples:16,max_split_comparisons:64,max_abs_value:100,max_parameters:32,max_fingerprint_elements:32,max_fingerprint_bytes:512,max_dataset_bytes:2048,max_json_depth:8,max_json_elements:4096,max_output_bytes:65536,max_adapter_elements:128,max_adapter_rank:2,max_base_parameters:32,max_adapter_parameters:32,min_learning_rate:0.000001,max_learning_rate:1,max_steps:300,max_tolerance:1,max_iterations:300,max_gradient_norm:1000,max_abs_parameter:100,max_loss:10000,max_parity_error:0.0000000001,max_curve_points:301};
base=reshape(fill([6],0),[2,3]);
initial_b=reshape([0.1,-0.1],[2,1]);
initial_a=reshape([0.5,0.5,0.5],[1,3]);
config={learning_rate:0.05,max_steps:200,tolerance:0.00001};
trained=u:low_rank_fine_tune("fixtures/adaptation/tiny-regression.json",base,initial_b,initial_a,config,b)?;
r=trained.report;
rank2=u:adapter_delta(reshape([1,0,0,1],[2,2]),reshape([1,0,0,0,1,0],[2,3]),b)?;
print("DEMO: frozen-base low-rank adapter fine-tuning");
print("Scenario: keep a zero 2x3 base matrix frozen while a rank-one B*A update learns two outputs, [y,-y], from the same four-example rule; compare factorized inference with explicitly merged weights on train and held-out data.");
print("Native boundary: bounded dataset read, matrix/numeric primitives, and generic tagged JSON. MLPL work: paired-target design, factor shapes/counts, B*A delta, manual chain-rule gradients for both factors, optimization, merge, parity checks, fingerprints, held-out evaluation, budgets, and report validation.");
print("Budgets: adapter rank at most two; six base and at most 32 adapter parameters; 200 requested/300 maximum steps and iterations; learning rate 0.05 within [0.000001,1]; 128 design elements; gradient/parameter/loss/parity ceilings; 301 curve points; 65536 report bytes and 4096 JSON elements.");
print("Frozen base and trained factor evidence:");
print({base: r.base,base_fingerprint_before: r.base_fingerprint,base_fingerprint_after: r.final_base_fingerprint,initial_b: r.initial_b,initial_a: r.initial_a,trained_b: r.trained_b,trained_a: r.trained_a,delta: r.delta,merged: r.merged});
print("Parameter accounting and convergence:");
print({rank: r.rank,base_parameters: r.base_parameters,trainable_parameters: r.trainable_parameters,parameter_reduction: r.parameter_reduction,total_stored_parameters: r.total_stored_parameters,updates: r.updates,stopping_reason: r.stopping_reason,initial_loss: r.train.initial_loss,final_loss: r.train.final_loss,held_out_loss: r.evaluation.loss,train_merge_error: r.train.merged_factorized_max_error,held_merge_error: r.evaluation.merged_factorized_max_error,rank_two_supported: rank2.rank,rank_two_trainable_parameters: rank2.trainable_parameters});
print("Selected trajectory:");
print({steps: [0,1,10,50,100,126],losses: [take(r.train.losses,0,0),take(r.train.losses,0,1),take(r.train.losses,0,10),take(r.train.losses,0,50),take(r.train.losses,0,100),take(r.train.losses,0,126)],gradient_steps: [0,1,10,50,100,125],gradient_norms: [take(r.train.gradient_norms,0,0),take(r.train.gradient_norms,0,1),take(r.train.gradient_norms,0,10),take(r.train.gradient_norms,0,50),take(r.train.gradient_norms,0,100),take(r.train.gradient_norms,0,125)],held_targets: r.evaluation.targets,held_predictions: r.evaluation.predictions,report_bytes: trained.utf8_bytes});
print("Interpretation: the base fingerprint is exactly unchanged while five rank-one factor values learn a six-value update near [[1,2,3],[-1,-2,-3]]. Merged and factorized predictions agree within the displayed floating tolerance. Five versus six trainable values is only a tiny teaching reduction; rank two would use ten and is explicitly not parameter-efficient here, so this is a mechanism demo rather than production-scale LoRA.");
ok(1)
