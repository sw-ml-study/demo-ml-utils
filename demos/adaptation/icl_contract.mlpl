b={max_examples_per_split:8,max_features:4,max_elements_per_split:32,max_total_examples:16,max_split_comparisons:64,max_abs_value:100,max_parameters:16,max_fingerprint_elements:16,max_fingerprint_bytes:256,max_dataset_bytes:2048,max_json_depth:10,max_json_elements:4096,max_output_bytes:32768,max_context_examples:4,max_query_examples:4,max_query_elements:32,max_context_query_comparisons:16,max_abs_prediction:1000}; built=u:icl_contract_report("fixtures/adaptation/tiny-regression.json",[0,0,0],b)?; r=built.report;
print("DEMO: bounded in-context-learning record contract"); print("Scenario: package two labeled context examples and three disjoint held-out queries while a frozen zero-parameter linear deployment model supplies an honest zero-shot baseline before any associative ICL mechanism is introduced."); print("Native boundary: bounded dataset read and generic tagged JSON. MLPL work: split/schema validation, cross-split leakage checks, context/query construction, frozen fingerprints, baseline inference and loss, budgets, mode semantics, and deterministic report validation."); print("Budgets: four context and four query examples, 32 query elements, 16 context/query comparisons, eight examples and four features per source split, finite magnitude 100, 32768 report bytes, JSON depth 10, and 4096 elements."); print("Context and query record:"); print({context_ids: r.record.context.ids,context_x: r.record.context.x,context_labels: r.record.context.labels,query_ids: r.record.query.ids,query_x: r.record.query.x,query_targets: r.record.query.targets,cross_checks: r.budgets.context_query_comparisons}); print("Frozen zero-shot evidence:"); print({deployment_parameters: r.deployment.parameters,fingerprint_before: r.deployment.fingerprint_before,fingerprint_after: r.deployment.fingerprint_after,deployment_updates: r.deployment.updates,context_labels_used: r.zero_shot.context_labels_used,predictions: r.zero_shot.predictions,mse: r.zero_shot.mse,report_bytes: built.utf8_bytes}); print("Interpretation: the baseline predicts zero and scores MSE 65 because it deliberately ignores the two context labels. Their value is visible but not yet consumed; the next step can therefore demonstrate genuine context-time improvement while proving the deployment parameter fingerprint never changes."); ok(1)
