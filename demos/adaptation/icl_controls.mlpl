include "../../src/adaptation/icl_controls.mlpl";
b={max_examples_per_split:8,max_features:4,max_elements_per_split:32,max_total_examples:16,max_split_comparisons:64,max_abs_value:100,max_parameters:16,max_fingerprint_elements:16,max_fingerprint_bytes:256,max_dataset_bytes:2048,max_json_depth:12,max_json_elements:8192,max_output_bytes:32768,max_context_examples:4,max_query_examples:4,max_query_elements:32,max_context_query_comparisons:32,max_abs_prediction:1000,max_association_work:64,max_abs_similarity:10,max_abs_contribution:100}; built=u:icl_controls_report("fixtures/adaptation/tiny-regression.json",[1,0,0],b)?; r=built.report;
print("DEMO: causal controls for frozen associative ICL"); print("Scenario: hold the model and queries fixed while changing only context order, adding a zero-vector distractor, introducing a conflicting feature example, truncating context, or selecting no context."); print("Native boundary: bounded data/JSON and numeric arrays. MLPL work: controlled record construction, duplicate/leakage validation, similarities, contributions, predictions, loss, fingerprints, and budgets."); print("Budgets: four context examples, three queries, 64 association operations, 32 context/query ID comparisons, bounded similarities/contributions/predictions, 32768 report bytes, JSON depth 12, and 8192 elements."); print("Prediction and loss effects:"); print({canonical_predictions: r.canonical.predictions,canonical_mse: r.canonical.mse,reversed_predictions: r.order_reversed.predictions,reversed_mse: r.order_reversed.mse,distractor_predictions: r.zero_vector_distractor.predictions,distractor_contributions: r.zero_vector_distractor.contributions,contradiction_predictions: r.contradictory_feature.predictions,contradiction_mse: r.contradictory_feature.mse,truncated_predictions: r.truncated_one_shot.predictions,truncated_mse: r.truncated_one_shot.mse,empty_predictions: r.empty_context.predictions,empty_mse: r.empty_context.mse}); print("Frozen-state and causal conclusions:"); print({fingerprint_before: r.deployment.fingerprint_before,fingerprint_after: r.deployment.fingerprint_after,updates: r.deployment.updates,order_invariant: r.interpretation.order_invariant,distractor_zero_contribution: r.interpretation.distractor_zero_contribution,truncation_removes_x2_evidence: r.interpretation.truncation_removes_x2_evidence,contradiction_can_harm: r.interpretation.contradiction_can_harm,empty_equals_zero_shot: r.interpretation.empty_equals_zero_shot,report_bytes: built.utf8_bytes}); print("Interpretation: additive context makes order irrelevant; the zero vector has zero similarity and no effect; truncation loses x2 evidence; no context returns to baseline; and the conflicting x1 example damages only x1-bearing queries. Duplicate IDs, query leakage, and exhausted work/comparison/context budgets fail before accepted inference."); ok(1)
