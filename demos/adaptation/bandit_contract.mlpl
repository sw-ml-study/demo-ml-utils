print("Native boundary: bounded fixture I/O, numeric primitives, and tagged JSON. MLPL work: task/split validation, reward-tape lookup, greedy/UCB action selection, history replay, cumulative reward/regret, budgets, labels, and deterministic report validation.");
print("Budgets: four arms, eight rounds/history records, four source and two held-out tasks, eight split comparisons, rewards in [0,1], 32768 report bytes, JSON depth 10, and 4096 elements.");
print("Environment and split evidence:");
print({held_out_task: r.environment.task_id,reward_tape: r.environment.reward_tape,arms: r.environment.arms,horizon: r.environment.horizon,training_tasks: r.dataset.training_tasks,held_out_tasks: r.dataset.held_out_tasks,task_comparisons: r.dataset.task_comparisons});
