include "../../src/adaptation/curve_ir.mlpl";
tb={max_examples_per_split:8,max_features:4,max_elements_per_split:32,max_total_examples:16,max_split_comparisons:64,max_abs_value:100,max_parameters:32,max_fingerprint_elements:32,max_fingerprint_bytes:512,max_dataset_bytes:2048,max_json_depth:8,max_json_elements:4096,max_output_bytes:65536,min_learning_rate:0.000001,max_learning_rate:1,max_steps:300,max_tolerance:1,max_iterations:300,max_abs_prediction:1000,max_gradient_norm:1000,max_abs_parameter:100,max_loss:10000,max_curve_points:301,max_adapter_elements:128,max_adapter_rank:2,max_base_parameters:32,max_adapter_parameters:32,max_parity_error:0.0000000001}; full=u:linear_fine_tune("fixtures/adaptation/tiny-regression.json",[0,0,0],{learning_rate:0.2,max_steps:60,tolerance:0.000001},tb)?; low=u:low_rank_fine_tune("fixtures/adaptation/tiny-regression.json",reshape(fill([6],0),[2,3]),reshape([0.1,-0.1],[2,1]),reshape([0.5,0.5,0.5],[1,3]),{learning_rate:0.05,max_steps:200,tolerance:0.00001},tb)?; built=u:adaptation_curve_ir(full,low,{max_curve_points:301,max_abs_value:10000,max_output_bytes:65536,max_json_depth:12,max_json_elements:8192})?; ir=built.ir;
print("DEMO: renderer-neutral fine-tuning evidence IR");
print("Scenario: normalize full-parameter and frozen-base low-rank training into one versioned artifact a chart, table, CLI, notebook, or audit tool can consume without knowing either trainer's private report shape.");
print("Native boundary: bounded dataset I/O, matrix/numeric primitives, and generic tagged JSON. MLPL work: both teaching trainers, canonical curve coordinates, update normalization, baselines, prediction alignment, provenance, schema validation, and budgets.");
print("Budgets: 301 points per loss curve, finite evidence magnitude 10000, 65536 encoded bytes, JSON depth 12, and 8192 decoded elements; the underlying trainers retain their own data, work, rank, gradient, parameter, and iteration limits.");
print("Consumer-facing identity and provenance:"); print({schema: ir.schema,version: ir.version,run_ids:[ir.runs.full.id,ir.runs.low_rank.id],strategies:[ir.runs.full.strategy,ir.runs.low_rank.strategy],dataset: ir.provenance.dataset,task: ir.provenance.task,encoded_bytes: built.utf8_bytes});
print("Comparable curves and held-out baselines:"); print({full_points: tally(ir.runs.full.curve.losses),full_first_loss: take(ir.runs.full.curve.losses,0,0),full_final_loss: take(ir.runs.full.curve.losses,0,tally(ir.runs.full.curve.losses)-1),full_baseline_loss: ir.runs.full.baseline.loss,full_held_loss: ir.runs.full.predictions.loss,low_rank_points: tally(ir.runs.low_rank.curve.losses),low_rank_first_loss: take(ir.runs.low_rank.curve.losses,0,0),low_rank_final_loss: take(ir.runs.low_rank.curve.losses,0,tally(ir.runs.low_rank.curve.losses)-1),low_rank_baseline_loss: ir.runs.low_rank.baseline.loss,low_rank_held_loss: ir.runs.low_rank.predictions.loss});
print("Update and prediction evidence:"); print({full_initial: ir.runs.full.update.initial,full_final: ir.runs.full.update.final,full_delta: ir.runs.full.update.delta,low_rank: ir.runs.low_rank.update.rank,low_rank_trainable: ir.runs.low_rank.update.trainable_parameters,low_rank_delta: ir.runs.low_rank.update.delta,low_rank_base_unchanged: equal(ir.runs.low_rank.update.base_fingerprint,ir.runs.low_rank.update.final_base_fingerprint),full_targets: ir.runs.full.predictions.targets,full_predictions: ir.runs.full.predictions.final,low_rank_targets: ir.runs.low_rank.predictions.targets,low_rank_predictions: ir.runs.low_rank.predictions.final});
print("Interpretation: both loss curves descend and both held-out losses beat their explicit no-training baselines. The IR preserves dense parameter deltas and factorized rank/merge evidence while giving renderers identical curve, prediction, baseline, and provenance channels; it is evidence transport, not a renderer or production trainer."); ok(1)
