include "../../src/adaptation/distilled_policy.mlpl";
b={max_arms:4,max_horizon:8,max_training_tasks:4,max_held_out_tasks:2,max_task_comparisons:8,min_reward:0,max_reward:1,max_history_records:8,max_dataset_bytes:2048,max_json_depth:10,max_json_elements:4096,max_output_bytes:32768,max_generated_tasks:4,max_generated_records:16,max_training_examples:8,max_parameters:8,max_fingerprint_elements:8,max_fingerprint_bytes:256,max_abs_value:100,min_probability:0.000000001,min_learning_rate:0.000001,max_learning_rate:1,max_steps:100,max_abs_parameter:100,max_curve_points:101}; built=u:distill_policy("fixtures/adaptation/tiny-bandits.json",[0,0],{learning_rate:0.5,steps:40},b)?; r=built.report; probes=u:policy_probabilities([-2,-1,0,1,2],r.artifact.parameters,b)?;
print("DEMO: offline distillation of a frozen history-conditioned policy"); print("Scenario: convert diverse source UCB histories into four reward-difference/action examples, train a two-parameter logistic policy offline, then freeze a versioned artifact for later held-out reward-context rollout."); print("Native boundary: bounded data/JSON, sigmoid/log, and numeric arrays. MLPL work: source example extraction, BCE loss, manual gradients, batch updates, fingerprints, artifact construction, budgets, and validation."); print("Budgets: eight training examples, eight parameters, 100 steps/101 curve points, learning rate at most 1, bounded parameters/probabilities, 32768 output bytes, JSON depth 10, and 4096 elements."); print("Offline training evidence:"); print({features: r.source.examples.features,labels: r.source.examples.labels,task_ids: r.source.task_ids,held_out_task_ids: r.source.held_out_task_ids,held_out_records_used: r.source.held_out_records_used,initial_parameters: r.training.initial_parameters,final_parameters: r.training.final_parameters,initial_loss: take(r.training.losses,0,0),final_loss: take(r.training.losses,0,40),updates: r.training.updates,fingerprint_before: r.training.fingerprint_before,fingerprint_after: r.training.fingerprint_after}); print("Frozen artifact behavior:"); print({artifact_schema: r.artifact.schema,artifact_version: r.artifact.version,frozen: r.artifact.frozen,feature: r.artifact.feature,probe_features:[-2,-1,0,1,2],action_one_probabilities: probes,offline_phase: r.phase,icrl_deployment_claim: r.icrl_deployment_claim,report_bytes: built.utf8_bytes}); print("Interpretation: offline updates learn a positive weight, mapping negative reward differences toward arm 0 and positive differences toward arm 1. Training is not ICRL; only the frozen artifact's later held-out behavior from growing reward context can support that claim."); ok(1)
