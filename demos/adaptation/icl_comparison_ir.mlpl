b={max_examples_per_split:8,max_features:4,max_elements_per_split:32,max_total_examples:16,max_split_comparisons:64,max_abs_value:100,max_parameters:16,max_fingerprint_elements:16,max_fingerprint_bytes:256,max_dataset_bytes:2048,max_json_depth:12,max_json_elements:8192,max_output_bytes:32768,max_context_examples:4,max_query_examples:4,max_query_elements:32,max_context_query_comparisons:32,max_abs_prediction:1000,max_association_work:64,max_abs_similarity:10,max_abs_contribution:100,max_evidence_elements:64}; built=u:icl_comparison_ir("fixtures/adaptation/tiny-regression.json",[1,0,0],0.000000001,b)?; ir=built.ir;
