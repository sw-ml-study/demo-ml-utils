include "../../src/adaptation/contract.mlpl";
b={max_examples_per_split:8,max_features:4,max_elements_per_split:32,max_total_examples:16,max_split_comparisons:64,max_abs_value:100,max_parameters:16,max_fingerprint_elements:16,max_fingerprint_bytes:256,max_dataset_bytes:2048,max_json_depth:8,max_json_elements:512,max_output_bytes:8192}; built=u:adaptation_contract_report("fixtures/adaptation/tiny-regression.json",b)?; r=built.report;
print("DEMO: shared fine-tuning, ICL, and ICRL adaptation contract"); print("Scenario: validate one generated two-feature task with disjoint train, labeled-context, and held-out evaluation IDs; pin what is allowed to change in each adaptation mode before any learner is implemented."); print("Native boundary: bounded dataset read, deterministic seeded random, numeric primitives, and generic tagged JSON. MLPL work: schema/shape/magnitude validation, duplicate and cross-split leakage checks, work budgets, canonical parameter fingerprint, terminology decisions, and report round-trip."); print("Budgets: eight examples and 32 feature elements per split; 16 total examples; four features; 64 leakage comparisons; values through magnitude 100; 16 parameters/fingerprint elements; 256 fingerprint, 2048 dataset, and 8192 report bytes; JSON depth 8 and 512 elements.");
print("Validated dataset:"); print(r.dataset); print("Adaptation distinctions:"); print({fine_tuning: r.terminology.fine_tuning,icl: r.terminology.icl,icrl: r.terminology.icrl,initial_parameter_fingerprint: r.parameter_fingerprint}); print("Executable numeric evidence:"); print({dot: r.numeric.dot,matmul: r.numeric.matmul,softmax: r.numeric.softmax,softmax_row_sums: r.numeric.softmax_row_sums,sigmoid_zero: r.numeric.sigmoid_zero,log_exp_one: r.numeric.log_exp_one,seeded_random: r.numeric.seeded_random,seeded_repeated: r.numeric.seeded_repeated,report_bytes: built.utf8_bytes}); print("Interpretation: fine-tuning is the only mode that requires deployment parameter updates. ICL changes predictions from labeled context, while ICRL changes behavior from action/reward history; both require an unchanged parameter fingerprint. Row-wise softmax sums to one and the repeated seed is identical, so later manual-gradient and attention demos have executable deterministic foundations."); ok(1)
