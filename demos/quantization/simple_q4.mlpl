b={max_values:64,max_iterations:64,max_output_values:64,max_abs_input:1000,max_output_bytes:64,max_decode_bytes:4096,max_json_depth:8,max_json_elements:256,max_report_fields:8,max_blocks:2,max_scale_iterations:32}; source=range(32)-16; q4=u:simple_q4_encode(source,b)?;
print("DEMO: explicit simple Q4 nibble round trip"); print("Scenario: compress the 32-value ramp -16..15 into one teaching Q4 block, then decode its exact bytes and measure reconstruction loss."); print("Native boundary: none. MLPL work: scale selection and binary16 packing, half-away rounding, -7..7 saturation, nibble packing/unpacking, decode, and error metrics. This explicit teaching layout is not labeled GGUF Q4_0."); print("Budgets: 64 values/iterations/outputs, magnitudes through 1000, two blocks, 64 payload bytes, and 32 scale-normalization iterations.");
print("Block layout: two scale bytes, then 16 bytes with even-index quant in the low nibble and odd-index quant in the high nibble; nibble 8 means zero."); print({scale_bytes: compress(lt(range(18),2),q4.bytes),stored_scale: take(q4.scales,0,0),packed_bytes: tally(q4.bytes)-2,total_bytes: tally(q4.bytes),f32_reference_bytes: tally(source)*4,compression_ratio: tally(source)*4/tally(q4.bytes)}); print("Reconstruction metrics and first eight absolute errors:"); print({rmse: q4.metrics.rmse,max_error: q4.metrics.max_error,cosine: q4.metrics.cosine,first_errors: compress(lt(range(32),8),q4.metrics.absolute_errors)}); print("Interpretation: 18 bytes replace 128 F32 bytes (7.11x smaller here), but four-bit codes visibly increase RMSE and maximum error compared with Q8_0; cosine shows how well the ramp direction remains aligned."); ok(1)
