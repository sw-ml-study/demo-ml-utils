include "../../src/quantization/symmetric_roundtrip.mlpl";
b={max_values:64,max_iterations:64,max_output_values:64,max_abs_input:1000,max_output_bytes:128,max_decode_bytes:4096,max_json_depth:8,max_json_elements:256,max_report_fields:8,max_blocks:2,max_scale_iterations:32}; source=range(32)-16; i8=u:symmetric_i8_encode(source,b)?; q8=u:q8_0_encode(source,b)?;
print("DEMO: symmetric INT8 and GGUF-compatible Q8_0 round trips"); print("Scenario: quantize the integer ramp -16..15 with a max-absolute signed-byte scale, first as a bare INT8 payload and then as one Q8_0 block with its scale rounded to binary16."); print("Native boundary: none. MLPL work: scale selection, nearest/half-away rounding, saturation, signed-byte packing, binary16 scale packing, Q8_0 block construction, independent decode, and reconstruction metrics."); print("Budgets: 64 values/iterations/outputs, magnitudes through 1000, two Q8_0 blocks, 128 output bytes, and 32 scale-normalization iterations.");
print("Bare symmetric INT8:"); print({scale: i8.scale,first_quant: take(i8.quants,0,0),zero_quant: take(i8.quants,0,16),last_quant: take(i8.quants,0,31),payload_bytes: tally(i8.bytes)}); print("Q8_0 block:"); print({scale_bytes: compress(lt(range(34),2),q8.bytes),stored_scale: take(q8.scales,0,0),payload_bytes: tally(q8.bytes),rmse: q8.metrics.rmse,max_error: q8.metrics.max_error,cosine: q8.metrics.cosine}); print("Interpretation: INT8 uses all 255 symmetric codes from -127 to 127. Q8_0 stores the scale in two binary16 bytes, so requantization follows that stored scale; 34 bytes reconstruct 32 source values with the displayed bounded error."); ok(1)
