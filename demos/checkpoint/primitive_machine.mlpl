include "../../src/checkpoint/primitive_machine.mlpl";
b={max_artifact_bytes:512,max_members:4,max_pickle_bytes:128,max_opcodes:64,max_strings:8,max_string_bytes:64,max_total_string_bytes:128,max_memo_entries:8,max_depth:8,max_iterations:64,max_output_bytes:16384,max_json_depth:8,max_json_elements:512,max_stack:16,max_nodes:16,max_list_items:16,max_dict_items:16}; result=u:checkpoint_primitive_machine("fixtures/checkpoint/benign.pt",b)?; m=result.machine; key=u:primitive_text(m,take(m.dict_keys,0,0))?; list_node=take(m.dict_values,0,0); values=u:primitive_list_numbers(m,list_node)?;
print("DEMO: restricted primitive pickle stack machine"); print("Scenario: open a tiny PyTorch-style data.pkl whose protocol-2 program builds the value {weight: [1, 2]}; validate its ZIP and opcode inventory first, then apply only inert primitive stack instructions."); print("Native boundary: file_size, two bounded whole-artifact reads (validation then byte extraction), and generic tagged JSON encode/decode. MLPL work: opcode dispatch, operand/mark stacks, numeric memo, typed node arena, list/dictionary edges, budgets, and all rejection decisions."); print("Budgets: 512 artifact and 128 pickle bytes; 64 opcodes/iterations; stack/nodes/list/dictionary ceilings 16; eight memo entries and mark depth; strings 64 bytes each/128 total; 16384 output bytes; JSON depth 8 and 512 elements.");
print("Pickle program result projected from the inert graph:"); print({root_node: m.root,dictionary_key: key,list_node: list_node,list_values: values}); print("Machine evidence:"); print({node_types: m.node_types,memo_indices: m.memo_indices,memo_values: m.memo_values,list_edges: tally(m.list_values),dictionary_edges: tally(m.dict_values),opcodes: m.opcode_count,encoded_bytes: result.utf8_bytes,safety: m.safety}); print("Interpretation: node type 1 is a dictionary, 2 a list, 3 bounded text, and 4 an integer. The edge tables visibly reconstruct weight -> [1, 2]. GLOBAL, STACK_GLOBAL, REDUCE, constructors, extensions, and persistence opcodes have no dispatch path and fail before any name resolution or invocation."); ok(1)
