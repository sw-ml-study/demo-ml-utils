include "../../src/checkpoint/passive_inventory.mlpl";
b={max_artifact_bytes:512,max_members:4,max_pickle_bytes:128,max_opcodes:64,max_strings:8,max_string_bytes:64,max_total_string_bytes:128,max_memo_entries:8,max_depth:8,max_iterations:64,max_output_bytes:4096,max_json_depth:8,max_json_elements:128};
benign=u:checkpoint_inventory("fixtures/checkpoint/benign.pt",b)?;
dangerous=u:checkpoint_inventory("fixtures/checkpoint/dangerous-global.pt",b)?;
print("DEMO: passive PyTorch-style ZIP/pickle risk inventory");
print("Scenario: inspect two tiny stored ZIP checkpoints byte-for-byte: one declarative protocol-2 dictionary/list stream and one stream naming GLOBAL os.system. Never deserialize either stream and never execute an opcode.");
print("Native boundary: file_size, one budgeted whole-artifact read, and generic JSON encode/decode. MLPL work: ZIP local/central/end validation, safe-member policy, pickle argument framing, opcode classification/counting, budgets, and risk report.");
print("Budgets: 512 artifact bytes, one accepted data.pkl member (member ceiling 4), 128 pickle bytes, 64 opcodes/iterations, eight strings/memo entries/mark depth, 64 bytes per string, 128 total string bytes, 4096 report bytes, JSON depth 8 and 128 elements.");
print("Benign inventory:");
print({artifact_bytes: benign.report.container.artifact_bytes,pickle_bytes: benign.report.container.data_pickle_bytes,protocol: benign.report.pickle.protocol,opcodes: benign.report.pickle.opcode_count,declarative: benign.report.pickle.declarative_opcodes,dangerous: benign.report.pickle.dangerous_opcodes,memo_ops: benign.report.pickle.memo_opcodes,max_mark_depth: benign.report.pickle.max_mark_depth,risk: benign.report.pickle.risk,execution_performed: benign.report.pickle.execution_performed});
print("Dangerous-name inventory:");
print({protocol: dangerous.report.pickle.protocol,opcodes: dangerous.report.pickle.opcode_count,global_opcodes: dangerous.report.pickle.global_opcodes,risk: dangerous.report.pickle.risk,execution_performed: dangerous.report.pickle.execution_performed});
print("Interpretation: the first stream is only eligible for later allow-list evaluation; it is not loaded here. Merely naming GLOBAL os.system makes the second report high risk, yet execution_performed remains zero because inventory advances over bytes rather than applying stack-machine behavior.");
ok(1)
