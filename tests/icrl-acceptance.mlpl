include "../src/adaptation/icrl_acceptance.mlpl";
def u:iareq(v,m) { "Require one final ICRL invariant."; if v { ok(1) } else { err(m) } }
def u:iab(rounds,output,atomic) { "Return final ICRL acceptance budgets."; {max_arms:4,max_horizon:8,max_training_tasks:4,max_held_out_tasks:2,max_task_comparisons:8,min_reward:0,max_reward:1,max_history_records:8,max_dataset_bytes:2048,max_json_depth:14,max_json_elements:16384,max_output_bytes: output,max_generated_tasks:4,max_generated_records:16,max_training_examples:8,max_parameters:8,max_fingerprint_elements:8,max_fingerprint_bytes:256,max_abs_value:100,min_probability:0.000000001,min_learning_rate:0.000001,max_learning_rate:1,max_steps:100,max_abs_parameter:100,max_curve_points:101,max_deployment_rounds: rounds,max_atomic_bytes: atomic} }
def u:iapath() { "Return temporary ICRL report path."; unwrap_or(list_get(args(),0),"") }
path=u:iapath(); b=u:iab(8,32768,32768); first=u:icrl_history_ir("fixtures/adaptation/tiny-bandits.json",b)?; second=u:icrl_history_ir("fixtures/adaptation/tiny-bandits.json",b)?; ir=first.ir;
u:iareq(equal(first.json,second.json)*equal(ir.variants.canonical.actions,[0,1,1,1])*eq(ir.variants.canonical.total_reward,3),"reproducible held-out golden")?; u:iareq(equal(ir.deployment.fingerprint_before,ir.deployment.fingerprint_after)*eq(ir.deployment.parameter_updates,0)*eq(ir.provenance.held_out_training_records,0),"frozen held-out separation")?;
malformed={schema:"sw-ml-study.bandit-tasks",version:1,arms:2,horizon:1,training:{extra:1,ids:[1],reward_tapes:[0,1]},held_out:{ids:[2],reward_tapes:[1,0]}}; nonfinite={schema:"sw-ml-study.bandit-tasks",version:1,arms:2,horizon:1,training:{ids:[1],reward_tapes:[pow(10,400),1]},held_out:{ids:[2],reward_tapes:[1,0]}}; u:iareq(is_err(u:bandit_tasks_validate(malformed,b))*is_err(u:bandit_tasks_validate(nonfinite,b)),"malformed and non-finite rejection")?; u:iareq(is_err(u:icrl_history_ir("fixtures/adaptation/tiny-bandits.json",u:iab(3,32768,32768))),"round exhaustion")?; u:iareq(is_err(u:icrl_history_ir("fixtures/adaptation/tiny-bandits.json",u:iab(8,100,32768))),"output exhaustion")?;
written=u:write_icrl_report(path,first,b)?; u:iareq(equal(read_bytes(path)?,tokenize_bytes(first.json))*eq(written.self_validated,1),"atomic exact semantic read-back")?; write_atomic(path,[9,8,7])?; u:iareq(is_err(u:write_icrl_report(path,first,u:iab(8,32768,100)))*equal(read_bytes(path)?,[9,8,7]),"atomic pre-write preservation")?; remove_path(path)?; print("PASS final ICRL acceptance"); ok(1)
