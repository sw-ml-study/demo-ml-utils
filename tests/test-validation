#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
test_root=$(mktemp -d "${TMPDIR:-/tmp}/demo-ml-utils-test.XXXXXX")
trap 'rm -rf "$test_root"' EXIT HUP INT TERM

"$repo_root/scripts/validate-catalog" "$repo_root/catalog/demos.tsv" >/dev/null
selected=$(MLPL=/bin/sh "$repo_root/scripts/select-mlpl")
test "$selected" = /bin/sh

cp "$repo_root/catalog/demos.tsv" "$test_root/bad.tsv"
printf 'duplicate\tdemos/a.mlpl\tsafetensors\tinspect\tmlpl\twhole-file\tno\tcurrent\tgated\n' >> "$test_root/bad.tsv"
printf 'duplicate\tdemos/b.mlpl\tgguf\tinspect\tmlpl\twhole-file\tno\tcurrent\tgated\n' >> "$test_root/bad.tsv"
if "$repo_root/scripts/validate-catalog" "$test_root/bad.tsv" >/dev/null 2>&1; then
  echo "catalog validator accepted duplicate ids" >&2
  exit 1
fi

if MLPL=relative/mlpl "$repo_root/scripts/select-mlpl" >/dev/null 2>&1; then
  echo "MLPL selector accepted a relative override" >&2
  exit 1
fi

# Identify checkpoints while reporting the missing Rust causal-LM provider.
fake_bin="$test_root/bin"; mkdir -p "$fake_bin"
cat > "$fake_bin/agentrail" <<'EOF'
#!/bin/sh
case "${1:-}" in
  --version) echo 'agentrail 0.1.0' ;;
  --help) echo 'Commands:'; echo '  next'; echo '  begin'; echo '  complete' ;;
  *) exit 2 ;;
esac
EOF
chmod +x "$fake_bin/agentrail"
for model in small coding; do
  model_dir="$test_root/$model-model"; mkdir -p "$model_dir"
  printf '{}\n' > "$model_dir/config.json"
  printf '{}\n' > "$model_dir/tokenizer.json"
  printf 'weights\n' > "$model_dir/model.safetensors"
done
preflight=$(PATH="$fake_bin:/usr/bin:/bin" \
  AGENTRAIL_SMALL_MODEL="$test_root/small-model" \
  AGENTRAIL_CODING_MODEL="$test_root/coding-model" \
  "$repo_root/scripts/check-agentrail-mlx-preflight")
printf '%s\n' "$preflight" | grep -Fqx 'overall=unavailable'
printf '%s\n' "$preflight" | grep -Fqx 'rust_causal_lm=missing'
printf '%s\n' "$preflight" | grep -Fqx 'memory_limit_mib=12288'
printf '%s\n' "$preflight" | grep -Fqx 'small_model=ready'
printf '%s\n' "$preflight" | grep -Fqx 'coding_model=ready'

mkdir -p "$repo_root/tmp/agentrail-small-data"
mlpl=$("$repo_root/scripts/select-mlpl")
small_data_output=$("$mlpl" --source-dir "$repo_root" "$repo_root/tests/agentrail-small-data.mlpl")
printf '%s\n' "$small_data_output" | grep -Fqx 'PASS Agentrail small-model dataset'
mkdir -p "$repo_root/tmp/agentrail-workflow-corpus"
workflow_output=$("$mlpl" --source-dir "$repo_root" "$repo_root/tests/agentrail-workflow-corpus.mlpl")
printf '%s\n' "$workflow_output" | grep -Fqx 'PASS frozen Agentrail workflow corpus'
for name in train.jsonl valid.jsonl test.jsonl manifest.json provenance.json; do
  cmp "$repo_root/tmp/agentrail-workflow-corpus/$name" "$repo_root/fixtures/training/agentrail-workflow/$name"
done
drift_output=$("$mlpl" --source-dir "$repo_root" "$repo_root/tests/agentrail-help-drift.mlpl")
printf '%s\n' "$drift_output" | grep -Fqx 'PASS Agentrail live-help drift comparison'
"$repo_root/tests/test-agentrail-leakage" >/dev/null
"$repo_root/tests/test-agentrail-adversarial" >/dev/null

echo "PASS validation tests"
