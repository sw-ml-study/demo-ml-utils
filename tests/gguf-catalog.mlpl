include "../src/formats/gguf_catalog.mlpl";
def u:gguf_fixture(name) { "Catalog one GGUF fixture with teaching budgets."; u:catalog_gguf(name, 4096, 8, 4, 256, 4, 1000000) }
def u:require_gguf(value, message) { "Require a GGUF test invariant."; if value { ok(1) } else { err(message) } }

catalog = u:gguf_fixture("fixtures/gguf/valid-small.gguf")?;
u:require_gguf(equal([catalog.version,catalog.metadata_count,catalog.tensor_count,catalog.alignment,catalog.data_bytes], [3,2,1,32,16]), "GGUF catalog aggregates")?;
u:require_gguf(equal(catalog.architecture, "demo") * equal(catalog.tensor_name_lengths, [6]) * equal(catalog.tensor_rows, reshape([0,4,0,16],[1,4])), "GGUF foundation tensor row")?;
u:require_gguf(equal(decode_bytes(read_bytes(catalog.path,take(catalog.tensor_name_offsets,0,0),take(catalog.tensor_name_lengths,0,0))?),"weight"),"lazy tensor-name range")?;

expanded = u:gguf_fixture("fixtures/gguf/valid-catalog.gguf")?;
u:require_gguf(equal([expanded.metadata_count,expanded.tensor_count,expanded.data_bytes], [4,4,132]), "expanded GGUF aggregates")?;
u:require_gguf(equal(expanded.metadata_type_counts, [0,0,0,0,2,0,0,1,1,0,0,0,0]), "metadata scalar type coverage")?;
u:require_gguf(equal(expanded.tensor_name_lengths, [5,5,4,5]), "deterministic tensor name lengths")?;
u:require_gguf(equal(expanded.tensor_rows, reshape([0,4,0,16, 32,32,8,34, 96,4,25,8, 128,4,24,4],[4,4])), "catalog-visible tensor types and known extents")?;
arrays = u:gguf_fixture("fixtures/gguf/valid-metadata-arrays.gguf")?;
u:require_gguf(equal([arrays.metadata_count,arrays.tensor_count,arrays.array_count,arrays.array_elements,arrays.array_payload_bytes],[7,1,3,9,62]), "metadata array aggregates")?;
u:require_gguf(equal(arrays.array_element_type_counts,[0,0,0,0,0,1,1,0,1,0,0,0,0]), "tokenizer string/F32/I32 array types")?;
u:require_gguf(equal(arrays.metadata_array_rows,reshape([-1,0,0,8,3,38,6,3,12,5,3,12,-1,0,0,-1,0,0,-1,0,0],[7,3])), "per-key metadata array descriptors and scalar widths")?;
u:require_gguf(equal(arrays.tensor_rows,reshape([0,4,0,16],[1,4])), "array cursor preserves tensor descriptor")?;
u:require_gguf(is_err(u:catalog_gguf("fixtures/gguf/valid-metadata-arrays.gguf",4096,8,4,256,4,8)), "metadata array element budget rejection")?;
u:require_gguf(is_err(u:gguf_fixture("fixtures/gguf/nested-metadata-array.gguf")), "nested metadata array rejection")?;
u:require_gguf(is_err(u:gguf_fixture("fixtures/gguf/truncated-metadata-array.gguf")), "truncated metadata array rejection")?;
u:require_gguf(is_err(u:gguf_fixture("fixtures/gguf/partial-q8-block.gguf")), "partial Q8_0 block rejection")?;
u:require_gguf(is_err(u:gguf_fixture("fixtures/gguf/bad-magic.gguf")), "GGUF magic rejection")?;
u:require_gguf(is_err(u:gguf_fixture("fixtures/gguf/truncated.gguf")), "GGUF truncation rejection")?;
u:require_gguf(is_err(u:gguf_fixture("fixtures/gguf/unsupported-version.gguf")), "GGUF version rejection")?;
u:require_gguf(is_err(u:gguf_fixture("fixtures/gguf/excessive-count.gguf")), "GGUF count budget rejection")?;
u:require_gguf(is_err(u:gguf_fixture("fixtures/gguf/unsupported-metadata-type.gguf")), "GGUF metadata type rejection")?;
u:require_gguf(is_err(u:gguf_fixture("fixtures/gguf/misaligned-offset.gguf")), "GGUF offset alignment rejection")?;
u:require_gguf(is_err(u:gguf_fixture("fixtures/gguf/unsupported-tensor-type.gguf")), "GGUF unsupported tensor type rejection")?;
u:require_gguf(is_err(u:gguf_fixture("fixtures/gguf/invalid-alignment.gguf")), "GGUF alignment rejection")?;
u:require_gguf(is_err(u:gguf_fixture("fixtures/gguf/duplicate-metadata.gguf")), "GGUF duplicate metadata rejection")?;
u:require_gguf(is_err(u:gguf_fixture("fixtures/gguf/duplicate-tensor.gguf")), "GGUF duplicate tensor rejection")?;
u:require_gguf(is_err(u:gguf_fixture("fixtures/gguf/overlapping-known.gguf")), "GGUF known extent overlap rejection")?;
print("PASS GGUF v3 catalog coverage"); ok(1)
