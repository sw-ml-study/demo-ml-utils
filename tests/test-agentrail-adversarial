#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cases="$repo_root/fixtures/evaluation/agentrail-adversarial/cases.jsonl"
test "$(wc -l < "$cases" | tr -d ' ')" = 12
test "$(grep -c '"automatic_execute":0' "$cases")" = 12
test "$(grep -c '"automatic_send":0' "$cases")" = 12
test "$(grep -o '"family":"[^"]*"' "$cases" | sort -u | wc -l | tr -d ' ')" = 6
test "$(grep -o '"id":"[^"]*"' "$cases" | sort -u | wc -l | tr -d ' ')" = 12
if grep -R -Fq 'adv-' "$repo_root/fixtures/training/agentrail-workflow"/*.jsonl; then
  echo "adversarial evaluation case leaked into training data" >&2
  exit 1
fi
printf '%s\n' "PASS Agentrail adversarial fixtures"
