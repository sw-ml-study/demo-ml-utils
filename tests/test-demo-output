#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/demo-output.XXXXXX")
trap 'rm -rf "$work_dir"' EXIT HUP INT TERM

check_demo() {
  name=$1
  script=$2
  output="$work_dir/$name.txt"
  "$repo_root/$script" >"$output"
  for marker in 'DEMO:' 'Scenario:' 'Native boundary:' 'Budgets:' 'Interpretation:'; do
    grep -Fq "$marker" "$output" || { echo "$name demo output lacks $marker" >&2; exit 1; }
  done
}

