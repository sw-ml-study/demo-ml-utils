#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/demo-output.XXXXXX")
trap 'rm -rf "$work_dir"' EXIT HUP INT TERM

check_demo() {
  name=$1
  script=$2
  output="$work_dir/$name.txt"
  "$repo_root/$script" >"$output"
  for marker in 'DEMO:' 'Scenario:' 'Native boundary:' 'Budgets:' 'Interpretation:'; do
    grep -Fq "$marker" "$output" || { echo "$name demo output lacks $marker" >&2; exit 1; }
  done
}

check_demo capabilities scripts/run-capability-probe
check_demo safetensors-headers scripts/run-safetensors-header-tests
check_demo safetensors-catalog scripts/run-safetensors-catalog
check_demo safetensors-slice scripts/run-safetensors-slice
check_demo safetensors-statistics scripts/run-safetensors-statistics
check_demo safetensors-summary scripts/run-safetensors-summary
check_demo scene-tiles scripts/run-scene-tiles
check_demo tensor-city scripts/run-tensor-city
check_demo detail-tiles scripts/run-detail-tiles
check_demo quantization-error scripts/run-quantization-error
check_demo transport scripts/run-transport
check_demo numeric-conversion scripts/run-numeric-conversion
check_demo symmetric-roundtrip scripts/run-symmetric-roundtrip
check_demo simple-q4 scripts/run-simple-q4
check_demo safetensors-to-gguf scripts/run-safetensors-to-gguf
check_demo gguf-catalog scripts/run-gguf-catalog
check_demo gguf-slice scripts/run-gguf-slice
check_demo gguf-q8-0 scripts/run-gguf-q8-0
check_demo gguf-statistics scripts/run-gguf-statistics

for marker in 'DEMO:' 'Scenario:' 'Native boundary:' 'Budgets:' 'Interpretation:'; do
  grep -Fq "$marker" "$repo_root/scripts/run-sparse-safetensors-acceptance" || { echo "sparse acceptance output lacks $marker" >&2; exit 1; }
done

for marker in 'DEMO:' 'Scenario:' 'Native boundary:' 'Budgets:' 'Interpretation:'; do
  grep -Fq "$marker" "$repo_root/scripts/run-sparse-gguf-acceptance" || { echo "sparse GGUF acceptance output lacks $marker" >&2; exit 1; }
done

for marker in 'DEMO:' 'Scenario:' 'Native boundary:' 'Budgets:' 'Interpretation:'; do
  grep -Fq "$marker" "$repo_root/scripts/run-external-oracle" || { echo "external oracle output lacks $marker" >&2; exit 1; }
done

echo "PASS self-describing demo output"
