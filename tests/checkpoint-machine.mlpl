include "../src/checkpoint/primitive_machine.mlpl";
def u:pmreq(v,m) {
  "Require a restricted primitive-machine invariant.";
  if v {
    ok(1)
  } else {
    err(m)
  }
}
b={max_artifact_bytes:512,max_members:4,max_pickle_bytes:128,max_opcodes:64,max_strings:8,max_string_bytes:64,max_total_string_bytes:128,max_memo_entries:8,max_depth:8,max_iterations:64,max_output_bytes:16384,max_json_depth:8,max_json_elements:512,max_stack:16,max_nodes:16,max_list_items:16,max_dict_items:16};
result=u:checkpoint_primitive_machine("fixtures/checkpoint/benign.pt",b)?;
m=result.machine;
u:pmreq(equal(m.node_types,[1,3,2,4,4])*equal(m.node_numbers,[0,0,0,1,2]),"primitive node graph golden")?;
u:pmreq(equal([m.root,m.opcode_count,result.inventory.dangerous_opcodes],[0,12,0]),"primitive root and inventory golden")?;
u:pmreq(equal(m.list_parents,[2,2])*equal(m.list_positions,[0,1])*equal(m.list_values,[3,4]),"primitive list edges golden")?;
u:pmreq(equal(m.dict_parents,[0])*equal(m.dict_keys,[1])*equal(m.dict_values,[2]),"primitive dictionary edge golden")?;
u:pmreq(equal(u:primitive_text(m,1)?,"weight")*equal(u:primitive_list_numbers(m,2)?,[1,2]),"primitive readable projection golden")?;
u:pmreq(equal(m.memo_indices,[0,1])*equal(m.memo_values,[0,2]),"primitive memo golden")?;
u:pmreq(equal([m.safety.global_resolution,m.safety.callable_invocation,m.safety.object_construction,m.safety.persistence_resolution],[0,0,0,0]),"primitive no-execution policy")?;
u:pmreq(is_err(u:checkpoint_primitive_machine("fixtures/checkpoint/dangerous-global.pt",b)),"GLOBAL rejection")?;
u:pmreq(is_err(u:primitive_pickle_machine([128,2,82,46],b)),"REDUCE rejection")?;
u:pmreq(is_err(u:primitive_pickle_machine([128,2,80,120,10,46],b)),"PERSID rejection")?;
u:pmreq(is_err(u:primitive_pickle_machine([128,2,130,1,46],b)),"extension rejection")?;
u:pmreq(is_err(u:primitive_pickle_machine([128,2,93,97,46],b)),"stack-underflow rejection")?;
