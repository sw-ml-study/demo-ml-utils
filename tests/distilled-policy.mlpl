include "../src/adaptation/distilled_policy.mlpl";
def u:dpreq(v,m) { "Require one distilled-policy invariant."; if v { ok(1) } else { err(m) } }
def u:dpb(steps,curve,output) { "Return distilled-policy budgets."; {max_arms:4,max_horizon:8,max_training_tasks:4,max_held_out_tasks:2,max_task_comparisons:8,min_reward:0,max_reward:1,max_history_records:8,max_dataset_bytes:2048,max_json_depth:10,max_json_elements:4096,max_output_bytes: output,max_generated_tasks:4,max_generated_records:16,max_training_examples:8,max_parameters:8,max_fingerprint_elements:8,max_fingerprint_bytes:256,max_abs_value:100,min_probability:0.000000001,min_learning_rate:0.000001,max_learning_rate:1,max_steps: steps,max_abs_parameter:100,max_curve_points: curve} }
b=u:dpb(100,101,32768); built=u:distill_policy("fixtures/adaptation/tiny-bandits.json",[0,0],{learning_rate:0.5,steps:40},b)?; r=built.report; p=u:policy_probabilities([-2,-1,1,2],r.artifact.parameters,b)?;
u:dpreq(gt(take(r.training.losses,0,0),take(r.training.losses,0,40))*lt(take(r.training.losses,0,40),0.1),"offline loss improvement")?; u:dpreq(lt(take(p,0,0),0.5)*lt(take(p,0,1),0.5)*gt(take(p,0,2),0.5)*gt(take(p,0,3),0.5),"learned sign decisions")?; u:dpreq(eq(r.artifact.frozen,1)*eq(r.training.updates,40)*1-equal(r.training.fingerprint_before,r.training.fingerprint_after),"updated then frozen artifact")?; u:dpreq(equal(r.source.held_out_task_ids,[501])*eq(r.source.held_out_records_used,0)*eq(r.icrl_deployment_claim,0),"held-out independence and phase label")?; u:dpreq(equal(u:distill_policy("fixtures/adaptation/tiny-bandits.json",[0,0],{learning_rate:0.5,steps:40},b)?.json,built.json),"deterministic report")?; u:dpreq(is_err(u:distill_policy("fixtures/adaptation/tiny-bandits.json",[0,0],{learning_rate:0.5,steps:40},u:dpb(39,101,32768))),"step budget rejection")?; u:dpreq(is_err(u:distill_policy("fixtures/adaptation/tiny-bandits.json",[0,0],{learning_rate:0.5,steps:40},u:dpb(100,40,32768))),"curve budget rejection")?;
print("PASS distilled context policy"); ok(1)
