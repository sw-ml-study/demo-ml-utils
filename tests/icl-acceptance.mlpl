u:iclareq(is_err(u:icl_comparison_ir("fixtures/adaptation/tiny-regression.json",[1,0,0],0.000000001,u:iclab(64,1,32,64,32768,32768))),"context exhaustion")?;
u:iclareq(is_err(u:icl_comparison_ir("fixtures/adaptation/tiny-regression.json",[1,0,0],0.000000001,u:iclab(64,4,32,5,32768,32768))),"evidence exhaustion")?;
u:iclareq(is_err(u:icl_comparison_ir("fixtures/adaptation/tiny-regression.json",[1,0,0],0.000000001,u:iclab(64,4,32,64,100,32768))),"output exhaustion")?;
written=u:write_icl_report(path,first,b)?;
u:iclareq(eq(written.atomic_write,1)*eq(written.self_validated,1)*equal(read_bytes(path)?,tokenize_bytes(first.json)),"atomic exact and semantic read-back")?;
