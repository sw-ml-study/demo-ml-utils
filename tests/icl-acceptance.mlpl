def u:iclareq(v,m) {
  "Require one final ICL acceptance invariant.";
  if v {
    ok(1)
  } else {
    err(m)
  }
}
def u:iclab(work,context,comparisons,evidence,output,atomic) {
  "Return final ICL acceptance budgets.";
  {max_examples_per_split:8,max_features:4,max_elements_per_split:32,max_total_examples:16,max_split_comparisons:64,max_abs_value:100,max_parameters:16,max_fingerprint_elements:16,max_fingerprint_bytes:256,max_dataset_bytes:2048,max_json_depth:12,max_json_elements:8192,max_output_bytes: output,max_context_examples: context,max_query_examples:4,max_query_elements:32,max_context_query_comparisons: comparisons,max_abs_prediction:1000,max_association_work: work,max_abs_similarity:10,max_abs_contribution:100,max_evidence_elements: evidence,max_atomic_bytes: atomic}
}
def u:icla_path() {
  "Return the required temporary report path.";
  unwrap_or(list_get(args(),0),"")
}
path=u:icla_path();
b=u:iclab(64,4,32,64,32768,32768);
first=u:icl_comparison_ir("fixtures/adaptation/tiny-regression.json",[1,0,0],0.000000001,b)?;
