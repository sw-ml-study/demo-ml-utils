u:iclareq(equal(first.ir.deployment.fingerprint_before,first.ir.deployment.fingerprint_after)*eq(first.ir.deployment.updates,0)*equal(controls.report.deployment.fingerprint_before,controls.report.deployment.fingerprint_after),"all accepted paths frozen")?;
