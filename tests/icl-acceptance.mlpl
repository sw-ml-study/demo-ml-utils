nonfinite={schema:"sw-ml-study.adaptation-dataset",version:1,task:"bad",feature_count:2,train:{ids:[1],x:[pow(10,400),0],y:[0]},context:{ids:[2],x:[0,0],y:[0]},evaluation:{ids:[3],x:[0,0],y:[0]}};
