#!/bin/sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
report=$(python3 "$repo_root/scripts/oracles/analyze_agentrail_leakage.py" "$repo_root/fixtures/training/agentrail-workflow")
printf '%s\n' "$report" | grep -Fq '"accepted": 1'
printf '%s\n' "$report" | grep -Fq '"duplicate_ids": 0'
printf '%s\n' "$report" | grep -Fq '"exact_cross_split_duplicates": 0'
printf '%s\n' "PASS Agentrail lexical leakage and coverage"
