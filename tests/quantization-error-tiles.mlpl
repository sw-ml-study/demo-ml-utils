include "../src/visualization/quantization_error_tiles.mlpl";
def u:req(v,m) { "Require a quantization tile invariant."; if v { ok(1) } else { err(m) } }
def u:qb(payload,blocks,points,refs,objects,metrics,iterations,output) { "Return quantization tile budgets."; {max_catalog_bytes:4096,max_metadata:8,max_tensors:4,max_string_bytes:256,max_rank:4,max_parameters:1000000,max_payload_bytes: payload,max_blocks: blocks,max_points: points,max_reference_values: refs,max_objects: objects,max_metric_fields: metrics,max_iterations: iterations,max_value:128,max_output_bytes: output,max_json_depth:8,max_json_elements:512} }
reference = range(32)/2-7.5; tile = u:build_q8_error_tile("fixtures/gguf/valid-catalog.gguf","gguf-error","quant",reference,u:qb(34,1,32,32,4,6,1,8192))?;
u:req(equal(tile.ir.tile.scale,0.5) * equal(tile.ir.tile.quants,range(32)-16) * equal(tile.ir.tile.errors,fill([32],-0.5)),"Q8_0 block and pointwise golden")?;
u:req(equal([tile.ir.tile.quantized_bytes,tile.ir.tile.reference_bytes,tile.ir.tile.rmse,tile.ir.tile.max_error],[34,128,0.5,0.5]),"Q8_0 size and error metrics")?;
u:req(gt(tile.ir.tile.cosine,0.99) * lt(tile.ir.tile.cosine,1),"Q8_0 cosine metric")?;
u:req(equal(u:qerror_metrics([0,0],[0,0]).cosine,1) * equal(u:qerror_metrics([0,0],[1,0]).cosine,0),"zero-vector cosine policy")?;
u:req(is_err(u:build_q8_error_tile("fixtures/gguf/valid-catalog.gguf","a","quant",reference,u:qb(33,1,32,32,4,6,1,8192))),"payload budget rejection")?;
u:req(is_err(u:build_q8_error_tile("fixtures/gguf/valid-catalog.gguf","a","quant",reference,u:qb(34,1,31,32,4,6,1,8192))),"point budget rejection")?;
u:req(is_err(u:build_q8_error_tile("fixtures/gguf/valid-catalog.gguf","a","quant",reference,u:qb(34,1,32,31,4,6,1,8192))),"reference budget rejection")?;
u:req(is_err(u:build_q8_error_tile("fixtures/gguf/valid-catalog.gguf","a","quant",reference,u:qb(34,1,32,32,3,6,1,8192))),"object budget rejection")?;
u:req(is_err(u:build_q8_error_tile("fixtures/gguf/valid-catalog.gguf","a","quant",reference,u:qb(34,1,32,32,4,6,1,256))),"output budget rejection")?;
again = u:build_q8_error_tile("fixtures/gguf/valid-catalog.gguf","gguf-error","quant",reference,u:qb(34,1,32,32,4,6,1,8192))?; u:req(equal(tile.json,again.json),"deterministic tagged JSON")?;
print("PASS Q8_0 quantization error tiles"); ok(1)
