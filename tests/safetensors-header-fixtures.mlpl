include "../src/formats/safetensors_header.mlpl";

def u:require_header(condition, message) { "Return Ok for a true fixture invariant, otherwise a named error."; if condition { ok(1) } else { err(message) } }

max_header_bytes = 4096;

valid = u:read_safetensors_header("fixtures/safetensors/valid-small.safetensors", max_header_bytes)?;
u:require_header(gt(valid.header_length, 2), "valid tensor header length")?;
u:require_header(equal(valid.file_size, 70), "valid tensor file size")?;
u:require_header(is_ok(parse_json(decode_bytes(valid.header_bytes), {max_depth: 8, max_bytes: max_header_bytes, max_elements: 32})), "valid tensor JSON")?;

valid_empty = u:read_safetensors_header("fixtures/safetensors/valid-empty.safetensors", max_header_bytes)?;
u:require_header(equal(valid_empty.header_length, 2), "empty map header length")?;
u:require_header(is_ok(parse_json(decode_bytes(valid_empty.header_bytes), {max_depth: 8, max_bytes: max_header_bytes, max_elements: 1})), "empty map JSON")?;

boundary = u:read_safetensors_header("fixtures/safetensors/boundary-header.safetensors", max_header_bytes)?;
u:require_header(equal(boundary.header_length, max_header_bytes), "maximum allowed header length")?;
u:require_header(is_ok(parse_json(decode_bytes(boundary.header_bytes), {max_depth: 8, max_bytes: max_header_bytes, max_elements: 1})), "padded boundary JSON")?;

u:require_header(is_err(u:read_safetensors_header("fixtures/safetensors/empty.safetensors", max_header_bytes)), "empty file rejection")?;
u:require_header(is_err(u:read_safetensors_header("fixtures/safetensors/truncated-prefix.safetensors", max_header_bytes)), "truncated prefix rejection")?;
u:require_header(is_err(u:read_safetensors_header("fixtures/safetensors/truncated-header.safetensors", max_header_bytes)), "truncated header rejection")?;
u:require_header(is_err(u:read_safetensors_header("fixtures/safetensors/oversized-header.safetensors", max_header_bytes)), "oversized header rejection")?;
u:require_header(is_err(u:read_safetensors_header("fixtures/safetensors/overflow-length.safetensors", max_header_bytes)), "u64 overflow rejection")?;

malformed = u:read_safetensors_header("fixtures/safetensors/malformed-json.safetensors", max_header_bytes)?;
u:require_header(is_err(parse_json(decode_bytes(malformed.header_bytes), {max_depth: 8, max_bytes: max_header_bytes, max_elements: 32})), "malformed JSON rejection")?;

u:require_header(equal(u:decode_safetensors_length([0,16,0,0,0,0,0,0], max_header_bytes)?, 4096), "little-endian boundary decode")?;
u:require_header(is_err(u:decode_safetensors_length([1,16,0,0,0,0,0,0], max_header_bytes)), "one byte over boundary")?;
u:require_header(is_err(u:decode_safetensors_length([0,0,0,0,0,0,32,0], max_header_bytes)), "2^53 length rejection")?;

print("PASS Safetensors header fixtures");
ok(1)
