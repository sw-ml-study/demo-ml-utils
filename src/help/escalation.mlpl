def u:help_bundle(q,destination,reason,b) { "Build a consent-minimized portable help context without executing or sending it."; if gt(tally(tokenize_bytes(q.source)),b.max_source_bytes)+gt(tally(tokenize_bytes(q.transcript)),b.max_transcript_bytes) { err("help source or transcript budget exceeded") } else { if q.consent_source { source=q.source; include_source=1 } else { source="[withheld]"; include_source=0 }; if q.consent_transcript { transcript=q.transcript; include_transcript=1 } else { transcript="[withheld]"; include_transcript=0 }; if gt(tally(tokenize_bytes(q.runtime_error)),0) { include_runtime_error=1 } else { include_runtime_error=0 }; bundle={destination: destination,question: q.question,language_version: q.language_version,reason: reason,retrieved_doc: q.retrieved_doc,include_runtime_error: include_runtime_error,runtime_error: q.runtime_error,include_source: include_source,source: source,include_transcript: include_transcript,transcript: transcript,automatic_send:0,automatic_execute:0}; encoded=to_json(bundle,{tagged:1})?; if gt(tally(tokenize_bytes(encoded)),b.max_context_bytes) { err("help context bundle budget exceeded") } else { ok(bundle) } } }
def u:help_result(q,outcome,tier,reason,destination,b) { "Return one typed help result and its inert context bundle."; bundle=u:help_bundle(q,destination,reason,b)?; if equal(outcome,"Answer") { answer={text: q.local_answer,citation: q.retrieved_doc,example: q.example} } else { answer={text:"",citation: q.retrieved_doc,example:""} }; ok({outcome: outcome,tier: tier,reason: reason,answer: answer,bundle: bundle}) }
def u:help_route(q,b) { "Route one feature-bearing help request through grounded browser help and explicit escalation tiers."; required=["consent_source","consent_transcript","doc_match","doc_version_current","domain","example","grounded","id","intent","language_version","local_answer","program_context","question","reasoning_required","repository_required","retrieved_doc","runtime_error","source","transcript"]; if 1-equal(record_keys(q),required) { err("help request schema mismatch") } else { if gt(tally(tokenize_bytes(q.question)),b.max_question_bytes) { err("help question byte budget exceeded") } else { if 1-equal(q.domain,"sw-mlpl") { u:help_result(q,"OutsideDomain","none","question is outside the bounded sw-MLPL help domain","none",b) } else { if q.repository_required { u:help_result(q,"NeedRepository","local-server","answer requires repository files, history, or implementation evidence","sw-mlpl-serve",b) } else { if q.reasoning_required { u:help_result(q,"NeedReasoning","portable-external","question exceeds the browser specialist's bounded reasoning contract","user-selected-ai",b) } else { if equal(q.intent,"program-analysis")*eq(q.program_context,0) { u:help_result(q,"NeedProgramContext","local-server","diagnosis requires source and runtime context unavailable to browser retrieval","sw-mlpl-serve",b) } else { if (1-eq(q.doc_match,1))+(1-eq(q.doc_version_current,1)) { u:help_result(q,"NeedDocs","browser-index","no current-version authoritative documentation match","refresh-local-index",b) } else { if eq(q.grounded,1) { u:help_result(q,"Answer","browser","current documentation and a runnable example ground the answer","none",b) } else { u:help_result(q,"NeedReasoning","portable-external","retrieval matched but answer consistency was not established","user-selected-ai",b) } } } } } } } } }
def u:help_escalation_demo(b) { "Run six visible questions through progressive help and return typed outcomes, privacy evidence, and inert bundles."; local_q={id:1,question:"How do I remove the first two array items?",domain:"sw-mlpl",intent:"how",doc_match:1,doc_version_current:1,grounded:1,program_context:0,repository_required:0,reasoning_required:0,language_version:"0.20.0",retrieved_doc:"Array operations / drop",local_answer:"Use drop to remove a prefix and retain the remaining array.",example:"drop(2, [10,20,30,40])",runtime_error:"",source:"",transcript:"",consent_source:0,consent_transcript:0}; program_q={id:2,question:"Why did my expression produce rank 3 instead of rank 2?",domain:"sw-mlpl",intent:"program-analysis",doc_match:1,doc_version_current:1,grounded:0,program_context:0,repository_required:0,reasoning_required:0,language_version:"0.20.0",retrieved_doc:"Shapes and rank",local_answer:"",example:"",runtime_error:"observed shape [2,3,4]",source:"x = reshape(iota(24), [2,3,4])",transcript:"",consent_source:1,consent_transcript:0}; repo_q={id:3,question:"Why does parser.rs reject this proposed syntax?",domain:"sw-mlpl",intent:"implementation",doc_match:0,doc_version_current:1,grounded:0,program_context:1,repository_required:1,reasoning_required:0,language_version:"0.20.0",retrieved_doc:"Parser reference",local_answer:"",example:"",runtime_error:"parse error at token 4",source:"x |> proposed syntax",transcript:"",consent_source:1,consent_transcript:0}; reasoning_q={id:4,question:"Compare sw-MLPL pipelines with category-theoretic applicatives.",domain:"sw-mlpl",intent:"comparative-reasoning",doc_match:1,doc_version_current:1,grounded:0,program_context:0,repository_required:0,reasoning_required:1,language_version:"0.20.0",retrieved_doc:"Composition overview",local_answer:"",example:"",runtime_error:"",source:"private_work = 42",transcript:"prior private discussion",consent_source:0,consent_transcript:0}; docs_q={id:5,question:"Was window_over added in this version?",domain:"sw-mlpl",intent:"where",doc_match:1,doc_version_current:0,grounded:0,program_context:0,repository_required:0,reasoning_required:0,language_version:"0.20.0",retrieved_doc:"stale index entry",local_answer:"",example:"",runtime_error:"",source:"",transcript:"",consent_source:0,consent_transcript:0}; outside_q={id:6,question:"What restaurant should I visit tonight?",domain:"general",intent:"recommendation",doc_match:0,doc_version_current:1,grounded:0,program_context:0,repository_required:0,reasoning_required:1,language_version:"0.20.0",retrieved_doc:"",local_answer:"",example:"",runtime_error:"",source:"",transcript:"",consent_source:0,consent_transcript:0}; local=u:help_route(local_q,b)?; program=u:help_route(program_q,b)?; repository=u:help_route(repo_q,b)?; reasoning=u:help_route(reasoning_q,b)?; docs=u:help_route(docs_q,b)?; outside=u:help_route(outside_q,b)?; counts=[equal(local.outcome,"Answer"),equal(docs.outcome,"NeedDocs"),equal(program.outcome,"NeedProgramContext"),equal(repository.outcome,"NeedRepository"),equal(reasoning.outcome,"NeedReasoning"),equal(outside.outcome,"OutsideDomain")]; ok({schema:"sw-ml-study.progressive-help",version:1,mechanics:{truth:"current docs and interpreter evidence",router:"deterministic typed capability contract",tiers:["browser","local-server","portable-external"],network_calls:0,commands_executed:0},local: local,program: program,repository: repository,reasoning: reasoning,docs: docs,outside: outside,counts: counts,fixtures:{oversized: local_q}}) }
