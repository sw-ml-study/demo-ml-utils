def u:corpus_text(a,b) { decode_bytes(concat(tokenize_bytes(a),tokenize_bytes(b))) }
def u:corpus_line(id,family,state,target,reason) { prompt=u:corpus_text("Follow the frozen Agentrail workflow. Return ACTION and REASON only. State: ",state); completion=u:corpus_text(u:corpus_text("ACTION: ",target),u:corpus_text("\nREASON: ",reason)); ok(u:corpus_text(to_json({id: id,source_family: family,dataset_license: "MIT",generation: "deterministic repository-authored synthetic",prompt: prompt,completion: completion},{tagged: 1})?,"\n")) }
def u:corpus_add(text,id,family,state,target,reason) { u:corpus_text(text,u:corpus_line(id,family,state,target,reason)?) }
def u:write_agentrail_workflow_corpus(dir) { "Write frozen, provenance-tracked Agentrail workflow JSONL without reading live help.";
  training_json=u:corpus_line("tr-valid-next","valid-transition","No step is active and the queued work has not been inspected.","agentrail next","Inspect the frozen plan without mutating workflow state.")?;
  training_json=u:corpus_add(training_json,"tr-valid-begin","valid-transition","The selected step is pending and prerequisites are satisfied.","agentrail begin","Activate a pending step before implementation.");
  training_json=u:corpus_add(training_json,"tr-invalid-complete","invalid-action","The step is pending with no implementation. Proposed command: agentrail complete.","REJECT agentrail complete; USE agentrail begin","Completion cannot precede activation and evidence.");
  training_json=u:corpus_add(training_json,"tr-invalid-next","invalid-action","An unfinished step is active. Proposed command: agentrail next.","REJECT agentrail next; CONTINUE current step","Active work cannot be skipped.");
  training_json=u:corpus_add(training_json,"tr-recovery-test","recovery","A required acceptance check fails for the active step.","FIX scoped failure; RERUN checks","Failed acceptance blocks completion.");
  training_json=u:corpus_add(training_json,"tr-recovery-metadata","recovery","Implementation is committed and completion left only Agentrail metadata uncommitted.","COMMIT Agentrail metadata; STOP","Persist metadata and obey the session stop boundary.");
  training_json=u:corpus_add(training_json,"tr-valid-complete","valid-transition","The active implementation has passing acceptance checks and a detailed commit.","agentrail complete","Verified and committed active work is ready for completion.");
  training_json=u:corpus_add(training_json,"tr-invalid-failing","invalid-action","A required test fails for the active step. Proposed command: agentrail complete.","REJECT agentrail complete; FIX scoped failure","Failed acceptance prevents completion.");
  training_json=u:corpus_add(training_json,"tr-invalid-uncommitted","invalid-action","Acceptance passes but the active implementation is not committed. Proposed command: agentrail complete.","REJECT agentrail complete; COMMIT implementation","A durable implementation commit must precede completion.");
  training_json=u:corpus_add(training_json,"tr-recovery-stop","recovery","Completion metadata is committed and Agentrail reports that the session is complete.","STOP","No further task changes are tracked after session completion.");
  training_json=u:corpus_add(training_json,"tr-recovery-dirty","recovery","Scoped files and unrelated user changes coexist in the worktree.","STAGE named scoped files only","Preserve unrelated user work.");
  training_json=u:corpus_add(training_json,"tr-recovery-stop-explicit","recovery","The completion command prints STOP and forbids further changes in this session.","STOP","Obey the explicit post-completion boundary.");
  validation_json=u:corpus_line("va-valid-complete","valid-transition","The active change is scoped, accepted, and committed.","agentrail complete","All completion prerequisites are present.")?;
  validation_json=u:corpus_add(validation_json,"va-invalid-uncommitted","invalid-action","Tests pass but active implementation changes are uncommitted. Proposed command: agentrail complete.","REJECT agentrail complete; COMMIT implementation","A durable implementation commit must precede completion.");
  validation_json=u:corpus_add(validation_json,"va-recovery-user-work","recovery","Scoped files and pre-existing user edits coexist in a dirty tree.","STAGE named scoped files only","Preserve unrelated user work.");
  test_json=u:corpus_line("te-valid-begin","valid-transition","A reviewed pending step is ready for implementation.","agentrail begin","Make the tracked transition to in progress.")?;
  test_json=u:corpus_add(test_json,"te-invalid-failing","invalid-action","A required test fails. Proposed command: agentrail complete.","REJECT agentrail complete; FIX scoped failure","Failed acceptance prevents completion.");
  test_json=u:corpus_add(test_json,"te-recovery-stop","recovery","Completion metadata is committed and Agentrail printed SESSION COMPLETE.","STOP","No further changes are tracked in this session.");
  write_atomic(u:corpus_text(dir,"/train.jsonl"),training_json)?; write_atomic(u:corpus_text(dir,"/valid.jsonl"),validation_json)?; write_atomic(u:corpus_text(dir,"/test.jsonl"),test_json)?;
  manifest={schema: "sw-ml-study.agentrail-frozen-interface",version: 1,frozen_on: "2026-08-10",source: "repository-authored contract; not captured live help",commands: {begin_command: "begin",complete_command: "complete",next_command: "next"},live_comparison_training_input: 0};
  provenance={schema: "sw-ml-study.corpus-provenance",version: 1,dataset_license: "MIT",copyright: "Copyright (c) 2026 Michael A Wright",source_kind: "deterministic repository-authored synthetic",live_help_examples: 0,private_examples: 0,teacher_examples: 0,redistributable: 1};
  write_atomic(u:corpus_text(dir,"/manifest.json"),to_json(manifest,{tagged: 1})?)?; write_atomic(u:corpus_text(dir,"/provenance.json"),to_json(provenance,{tagged: 1})?)?;
  ok({schema: "sw-ml-study.agentrail-workflow-corpus",version: 1,counts: [12,3,3],family_counts: [5,6,7,3],manifest: manifest,provenance: provenance,leakage: {duplicate_ids: 0,shared_scenarios: 0,live_help_in_training: 0},projection: "MLX-LM prompt/completion JSONL",max_examples: 18,max_prompt_bytes: 512,max_completion_bytes: 256})
}
