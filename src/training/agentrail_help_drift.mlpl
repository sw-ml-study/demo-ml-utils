def u:drift_contains(haystack,needle) { h=tokenize_bytes(haystack); n=tokenize_bytes(needle); found=0; i=0; while lt(i,tally(h)-tally(n)+1) { same=1; j=0; while lt(j,tally(n)) { if 1-eq(take(h,0,i+j),take(n,0,j)) { same=0 } else { 0 }; j=j+1 }; if same { found=1 } else { 0 }; i=i+1 }; found }
def u:agentrail_help_drift(commands_path,max_commands,max_bytes) { "Compare captured live command names with the frozen three-command training contract."; size=file_size(commands_path)?; if gt(size,max_bytes) { err("live command manifest byte budget exceeded") } else { text=decode_bytes(read_bytes(commands_path,0,size)?); count=reduce_add(eq(tokenize_bytes(text),10))-1; if gt(count,max_commands) { err("live command count budget exceeded") } else { next_present=u:drift_contains(text,"\nnext\n"); begin_present=u:drift_contains(text,"\nbegin\n"); complete_present=u:drift_contains(text,"\ncomplete\n"); present=next_present+begin_present+complete_present; ok({schema: "sw-ml-study.agentrail-help-drift",version: 1,required_present: [next_present,begin_present,complete_present],missing_required: 3-present,live_command_count: count,added_out_of_scope: count-present,breaking_drift: gt(3-present,0),training_contamination: 0,authority: "deterministic manifest comparison",model_authority: 0,max_commands: max_commands,max_bytes: max_bytes}) } } }

def u:agentrail_help_scope(commands_path,options_path,max_commands,max_command_bytes,max_option_bytes) { "Classify the complete live command surface and validate frozen trained-command option signatures.";
  base=u:agentrail_help_drift(commands_path,max_commands,max_command_bytes)?; option_size=file_size(options_path)?;
  if gt(option_size,max_option_bytes) { err("live option manifest byte budget exceeded") } else { options=decode_bytes(read_bytes(options_path,0,option_size)?); option_lines=reduce_add(eq(tokenize_bytes(options),10))-1;
  next_signature=u:drift_contains(options,"\nnext|--strict\n")*u:drift_contains(options,"\nnext|-h\n")*u:drift_contains(options,"\nnext|--help\n");
  begin_signature=u:drift_contains(options,"\nbegin|-h\n")*u:drift_contains(options,"\nbegin|--help\n");
  complete_signature=u:drift_contains(options,"\ncomplete|--summary\n")*u:drift_contains(options,"\ncomplete|--next-slug\n")*u:drift_contains(options,"\ncomplete|--next-prompt\n")*u:drift_contains(options,"\ncomplete|--next-context\n")*u:drift_contains(options,"\ncomplete|--next-role\n")*u:drift_contains(options,"\ncomplete|--next-task-type\n")*u:drift_contains(options,"\ncomplete|--planned\n")*u:drift_contains(options,"\ncomplete|--done\n")*u:drift_contains(options,"\ncomplete|--reward\n")*u:drift_contains(options,"\ncomplete|--actions\n")*u:drift_contains(options,"\ncomplete|--failure-mode\n")*u:drift_contains(options,"\ncomplete|-h\n")*u:drift_contains(options,"\ncomplete|--help\n");
  valid_signatures=next_signature+begin_signature+complete_signature; trained=3-base.missing_required; unsupported=base.missing_required+(3-valid_signatures); rejected=base.live_command_count-trained;
  ok({schema: "sw-ml-study.agentrail-live-scope",version: 1,live_command_count: base.live_command_count,trained_commands: trained,rejected_out_of_scope: rejected,unsupported_trained_contracts: unsupported,trained_option_signatures: [next_signature,begin_signature,complete_signature],option_manifest_lines: option_lines,breaking_drift: gt(unsupported,0),training_contamination: 0,authority: "deterministic manifest and signature comparison",model_authority: 0,max_option_bytes: max_option_bytes})
  }
}
