include "numeric_conversion.mlpl";
include "../formats/gguf_q8_0.mlpl";

def u:round_away(value) {
  "Round a finite scalar to nearest integer with halves away from zero.";
  if lt(value,0) {
    0-floor(abs(value)+0.5)
  } else {
    floor(value+0.5)
  }
}
def u:fp16_encode_finite(value,max_iterations) {
  "Encode one finite scalar as little-endian IEEE binary16 bytes.";
  if (1-eq(rank(value),0))+(1-eq(value,value))+gt(abs(value),65504)+(1-eq(max_iterations,floor(max_iterations)))+lt(max_iterations,1) {
    err("invalid finite binary16 encoding input or budget")
  } else {
    if eq(value,0) {
      ok([0,0])
    } else {
      sign=if lt(value,0) {
        32768
      } else {
        0
      };
      magnitude=abs(value);
      if lt(magnitude,pow(2,-14)) {
        fraction=u:round_away(magnitude*pow(2,24));
        if gt(fraction,1023) {
          fraction=1023
        } else {
          0
        };
        bits=sign+fraction;
        ok([mod(bits,256),floor(bits/256)])
      } else {
        scaled=magnitude;
        exponent=0;
        iterations=0;
        while gt(scaled,2-0.000000000000001) {
          if gt(iterations,max_iterations-1) {
            return err("binary16 normalization iteration budget exceeded")
          } else {
            0
          };
          scaled=scaled/2;
          exponent=exponent+1;
          iterations=iterations+1
        };
        while lt(scaled,1) {
          if gt(iterations,max_iterations-1) {
            return err("binary16 normalization iteration budget exceeded")
          } else {
            0
          };
          scaled=scaled*2;
          exponent=exponent-1;
          iterations=iterations+1
        };
        fraction=u:round_away((scaled-1)*1024);
        if eq(fraction,1024) {
          fraction=0;
          exponent=exponent+1
        } else {
          0
        };
        encoded_exponent=exponent+15;
        if gt(encoded_exponent,30) {
          err("binary16 encoding overflow")
        } else {
          bits=sign+encoded_exponent*1024+fraction;
          ok([mod(bits,256),floor(bits/256)])
        }
      }
    }
  }
}
def u:symmetric_i8_encode(values,b) {
  "Encode one bounded vector using max-absolute symmetric signed-byte quantization.";
  u:numeric_valid_vector(values,b)?;
  if gt(tally(values),b.max_output_values)+gt(tally(values),b.max_output_bytes) {
    err("symmetric i8 output budget exceeded")
  } else {
    maximum=reduce(:max,abs(values));
    scale=if eq(maximum,0) {
      0
    } else {
      maximum/127
    };
    index=0;
    quants=fill([0],0);
    bytes=fill([0],0);
    while lt(index,tally(values)) {
      quant=if eq(scale,0) {
        0
      } else { u:round_away(take(values,0,index)/scale) };
      if lt(quant,-127) {
        quant=-127
      } else {
        if gt(quant,127) {
          quant=127
        } else {
          0
        }
      };
      quants=concat(quants,quant);
      bytes=concat(bytes,if lt(quant,0) {
          quant+256
        } else {
          quant
        });
      index=index+1
    };
    ok({scale: scale,quants: quants,bytes: bytes,reconstructed: quants*scale})
  }
}
def u:symmetric_i8_decode(bytes,scale,b) {
  "Decode budgeted signed-byte payload with a finite non-negative scale.";
  if (1-eq(rank(bytes),1))+gt(tally(bytes),b.max_values)+gt(tally(bytes),b.max_iterations)+gt(tally(bytes),b.max_output_values)+(1-eq(scale,scale))+lt(scale,0)+gt(scale,b.max_abs_input) {
    err("invalid symmetric i8 decode input or budget")
  } else {
    index=0;
    while lt(index,tally(bytes)) {
      byte=take(bytes,0,index);
      if (1-eq(byte,floor(byte)))+lt(byte,0)+gt(byte,255) {
        return err("symmetric i8 payload contains a non-byte")
      } else {
        0
      };
      index=index+1
    };
    quants=u:gguf_decode_signed(bytes,1);
    ok({quants: quants,values: quants*scale})
  }
}
def u:q8_0_encode(values,b) {
  "Encode complete 32-value blocks as binary16-scale Q8_0 payload bytes.";
  u:numeric_valid_vector(values,b)?;
  if (1-eq(mod(tally(values),32),0))+gt(tally(values)/32,b.max_blocks)+gt(tally(values)+2*(tally(values)/32),b.max_output_bytes) {
    err("Q8_0 encode shape, block, or byte budget exceeded")
  } else {
    block=0;
    payload=fill([0],0);
    scales=fill([0],0);
    positions=range(tally(values));
    while lt(block,tally(values)/32) {
      begin=block*32;
      selected=compress(gt(positions,begin-1)*lt(positions,begin+32),values);
      encoded=u:symmetric_i8_encode(selected,b)?;
      scale_bytes=u:fp16_encode_finite(encoded.scale,b.max_scale_iterations)?;
      stored_scale=u:gguf_fp16(scale_bytes)?;
      requantized=if eq(stored_scale,0) {
        fill([32],0)
      } else {
        index=0;
        output=fill([0],0);
        while lt(index,32) {
          quant=u:round_away(take(selected,0,index)/stored_scale);
          if lt(quant,-127) {
            quant=-127
          } else {
            if gt(quant,127) {
              quant=127
            } else {
              0
            }
          };
          output=concat(output,if lt(quant,0) {
              quant+256
            } else {
              quant
            });
          index=index+1
        };
        output
      };
      payload=concat(payload,concat(scale_bytes,requantized));
      scales=concat(scales,stored_scale);
      block=block+1
    };
    decoded=u:gguf_decode_q8_0(payload,b.max_blocks,b.max_output_values)?;
    metrics=u:numeric_error_metrics(values,decoded.values,b)?;
    ok({bytes: payload,scales: scales,reconstructed: decoded.values,metrics: metrics,blocks: decoded.blocks})
  }
}
