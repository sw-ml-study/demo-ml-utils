def u:numeric_valid_vector(values,b) {
  "Validate one bounded finite rank-one numeric vector.";
  if (1 - equal(type_of(values),"array")) + (1 - eq(rank(values),1)) + lt(tally(values),1) + gt(tally(values),b.max_values) + gt(tally(values),b.max_iterations) {
    err("numeric vector shape or work budget exceeded")
  } else {
    index=0;
    while lt(index,tally(values)) {
      value=take(values,0,index);
      if (1 - eq(value,value)) + gt(abs(value),b.max_abs_input) {
        return err("numeric vector contains a non-finite or over-budget value")
      } else {
        0
      };
      index=index+1
    };
    ok(1)
  }
}
def u:truncate_zero(value) {
  "Truncate a finite scalar toward zero.";
  if lt(value,0) {
    0-floor(0-value)
  } else {
    floor(value)
  }
}
def u:convert_scalar(value,kind) {
  "Apply an explicit teaching conversion policy to one validated scalar.";
  if equal(kind,"i8") {
    truncated=u:truncate_zero(value);
    if lt(truncated,-128) {
      ok(-128)
    } else {
      if gt(truncated,127) {
        ok(127)
      } else {
        ok(truncated)
      }
    }
  } else {
    if equal(kind,"u8") {
      truncated=u:truncate_zero(value);
      if lt(truncated,0) {
        ok(0)
      } else {
        if gt(truncated,255) {
          ok(255)
        } else {
          ok(truncated)
        }
      }
    } else {
      if equal(kind,"f64") {
        ok(value)
      } else {
        err("unsupported numeric conversion kind")
      }
    }
  }
}
def u:convert_values(values,kind,b) {
  "Convert a bounded vector with visible truncation and saturation policy.";
  u:numeric_valid_vector(values,b)?;
  if gt(tally(values),b.max_output_values) {
    err("numeric conversion output budget exceeded")
  } else {
    index=0;
    output=fill([0],0);
    while lt(index,tally(values)) {
      converted=u:convert_scalar(take(values,0,index),kind)?;
      output=concat(output,converted);
      index=index+1
    };
    ok(output)
  }
}
def u:numeric_error_metrics(reference,candidate,b) {
  "Compute bounded absolute, RMSE, maximum, and cosine comparison evidence.";
  u:numeric_valid_vector(reference,b)?;
  u:numeric_valid_vector(candidate,b)?;
  if 1-eq(tally(reference),tally(candidate)) {
    err("numeric comparison vectors must have equal lengths")
  } else {
    errors=candidate-reference;
    absolute=abs(errors);
    reference_norm2=reduce_add(reference*reference);
    candidate_norm2=reduce_add(candidate*candidate);
    cosine=if eq(reference_norm2,0)*eq(candidate_norm2,0) {
      1
    } else {
      if eq(reference_norm2,0)+eq(candidate_norm2,0) {
        0
      } else {
        reduce_add(reference*candidate)/sqrt(reference_norm2*candidate_norm2)
      }
    };
    ok({count: tally(reference),absolute_errors: absolute,rmse: sqrt(reduce_add(errors*errors)/tally(errors)),max_error: reduce(:max,absolute),cosine: cosine})
  }
}
def u:numeric_conversion_report(values,reference,b) {
  "Build and JSON-round-trip bounded conversion and comparison evidence.";
  if lt(b.max_report_fields,8) {
    err("numeric report field budget exceeded")
  } else {
    i8=u:convert_values(values,"i8",b)?;
    u8=u:convert_values(values,"u8",b)?;
    f64=u:convert_values(values,"f64",b)?;
    metrics=u:numeric_error_metrics(reference,i8,b)?;
    report={schema:"sw-ml-study.numeric-conversion",version:1,policies:{integer_rounding:"truncate-toward-zero",integer_overflow:"saturate",floating:"f64-identity"},input: values,i8: i8,u8: u8,f64: f64,metrics: metrics};
    json=to_json(report,{tagged:1})?;
    bytes=tally(tokenize_bytes(json));
    if gt(bytes,b.max_output_bytes) {
      err("numeric report byte budget exceeded")
    } else {
      decoded=parse_json(json,{max_depth: b.max_json_depth,max_bytes: b.max_decode_bytes,max_elements: b.max_json_elements})?;
      if 1-equal(decoded,report) {
        err("numeric report JSON round trip changed evidence")
      } else {
        ok({report: report,json: json,utf8_bytes: bytes})
      }
    }
  }
}
