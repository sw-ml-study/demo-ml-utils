include "history_generator.mlpl";
include "contract.mlpl";

def u:policy_source_examples(histories) {
  "Extract bounded post-exploration history features and next-action labels from source tasks.";
  h0=histories.report.histories.task_401.history;
  h1=histories.report.histories.task_402.history;
  ok({features:[-1,-2,1,2],labels:[take(h0.actions,0,2),take(h0.actions,0,3),take(h1.actions,0,2),take(h1.actions,0,3)],task_ids:[401,401,402,402],held_out_records:0})
}
def u:policy_probabilities(features,parameters,b) {
  "Predict action-one probabilities from a scalar reward-history feature.";
  if 1-eq(tally(parameters),2)+gt(tally(features),b.max_training_examples) {
    err("distilled policy parameter or example budget exceeded")
  } else {
    probabilities=sigmoid(take(parameters,0,0)+take(parameters,0,1)*features);
    if lt(reduce(:min,probabilities),b.min_probability)+gt(reduce(:max,probabilities),1-b.min_probability) {
      err("distilled policy probability stability budget exceeded")
    } else {
      ok(probabilities)
    }
  }
}
def u:policy_loss(features,labels,parameters,b) {
  "Compute binary cross entropy for source-history action distillation.";
  p=u:policy_probabilities(features,parameters,b)?;
  ok(0-reduce_add(labels*log(p)+(1-labels)*log(1-p))/tally(labels))
}
def u:distill_policy(path,initial,config,b) {
  "Train a tiny policy offline on source histories and publish frozen versioned parameters.";
  if lt(config.learning_rate,b.min_learning_rate)+gt(config.learning_rate,b.max_learning_rate)+lt(config.steps,1)+gt(config.steps,b.max_steps) {
    err("distilled policy configuration budget exceeded")
  } else {
    histories=u:source_histories_report(path,b)?;
    examples=u:policy_source_examples(histories)?;
    before=u:adaptation_fingerprint(initial,b)?;
    parameters=initial;
    losses=concat(fill([0],0),u:policy_loss(examples.features,examples.labels,parameters,b)?);
    step=0;
    while lt(step,config.steps) {
      probabilities=u:policy_probabilities(examples.features,parameters,b)?;
      errors=probabilities-examples.labels;
      gradient=[reduce_add(errors)/tally(errors),reduce_add(errors*examples.features)/tally(errors)];
      parameters=parameters-config.learning_rate*gradient;
      if gt(reduce(:max,abs(parameters)),b.max_abs_parameter) {
        return err("distilled policy parameter magnitude budget exceeded")
      } else {
        losses=concat(losses,u:policy_loss(examples.features,examples.labels,parameters,b)?)
      };
      step=step+1
    };
    after=u:adaptation_fingerprint(parameters,b)?;
    if equal(before,after)+1-gt(take(losses,0,0),take(losses,0,tally(losses)-1)) {
      err("distilled policy failed to update or improve")
    } else {
      artifact={schema:"sw-ml-study.distilled-context-policy",version:1,parameters: parameters,fingerprint: after,feature:"arm1-reward-minus-arm0-reward",decision:"action-1-when-probability-at-least-0.5",frozen:1};
      report={schema:"sw-ml-study.distilled-policy-training",version:1,phase:"offline-source-training",icrl_deployment_claim:0,source:{task_ids:[401,402],examples: examples,held_out_task_ids: histories.report.provenance.held_out_task_ids,held_out_records_used:0},training:{initial_parameters: initial,final_parameters: parameters,fingerprint_before: before,fingerprint_after: after,updates: config.steps,learning_rate: config.learning_rate,losses: losses},artifact: artifact,boundary:{gradients:"manual-mlpl",optimizer:"batch-gradient-descent",external_training:0}};
      json=to_json(report,{tagged:1})?;
      size=tally(tokenize_bytes(json));
      if gt(tally(losses),b.max_curve_points)+gt(size,b.max_output_bytes) {
        err("distilled policy curve or output budget exceeded")
      } else {
        decoded=parse_json(json,{max_depth: b.max_json_depth,max_bytes: b.max_output_bytes,max_elements: b.max_json_elements})?;
        if 1-equal(decoded,report) {
          err("distilled policy report round trip changed")
        } else {
          ok({report: report,json: json,utf8_bytes: size})
        }
      }
    }
  }
}
