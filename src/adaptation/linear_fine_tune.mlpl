include "contract.mlpl";

def u:linear_predict(flat_x,features,parameters,b) {
  "Predict a flattened feature matrix with one bias plus bounded linear weights.";
  examples=tally(flat_x)/features;
  if 1-eq(tally(parameters),features+1)+gt(examples,b.max_examples_per_split)+gt(examples*features,b.max_elements_per_split) {
    err("linear prediction shape or work budget exceeded")
  } else {
    predictions=fill([0],0);
    row=0;
    while lt(row,examples) {
      value=take(parameters,0,0);
      feature=0;
      while lt(feature,features) {
        value=value+take(parameters,0,feature+1)*take(flat_x,0,row*features+feature);
        feature=feature+1
      };
      if (1-eq(value,value))+gt(abs(value),b.max_abs_prediction) {
        return err("linear prediction is non-finite or over budget")
      } else {
        predictions=concat(predictions,value)
      };
      row=row+1
    };
    ok(predictions)
  }
}
def u:linear_mse(predictions,targets) {
  "Compute mean squared error for equal non-empty vectors.";
  if eq(tally(predictions),0)+1-eq(tally(predictions),tally(targets)) {
    err("linear MSE vectors must be equal and non-empty")
  } else {
    errors=predictions-targets;
    ok(reduce_add(errors*errors)/tally(errors))
  }
}
def u:linear_gradient(flat_x,targets,features,parameters,b) {
  "Compute the explicit batch-MSE gradient for bias and linear weights.";
  predictions=u:linear_predict(flat_x,features,parameters,b)?;
  errors=predictions-targets;
  examples=tally(targets);
  gradient=concat(2*reduce_add(errors)/examples,fill([features],0));
  feature=0;
  while lt(feature,features) {
    total=0;
    row=0;
    while lt(row,examples) {
      total=total+take(errors,0,row)*take(flat_x,0,row*features+feature);
      row=row+1
    };
    gradient=scatter(gradient,feature+1,2*total/examples);
    feature=feature+1
  };
  norm=sqrt(reduce_add(gradient*gradient));
  if (1-eq(norm,norm))+gt(norm,b.max_gradient_norm) {
    err("linear gradient is non-finite or over budget")
  } else {
    ok({predictions: predictions,gradient: gradient,norm: norm,loss: u:linear_mse(predictions,targets)?})
  }
}
def u:linear_config(config,b) {
  "Validate bounded deterministic gradient-descent controls.";
  if 1-equal(record_keys(config),["learning_rate","max_steps","tolerance"])+(1-eq(config.learning_rate,config.learning_rate))+lt(config.learning_rate,b.min_learning_rate)+gt(config.learning_rate,b.max_learning_rate)+(1-eq(config.max_steps,floor(config.max_steps)))+lt(config.max_steps,1)+gt(config.max_steps,b.max_steps)+(1-eq(config.tolerance,config.tolerance))+lt(config.tolerance,0)+gt(config.tolerance,b.max_tolerance) {
    err("linear fine-tuning configuration is outside its budget")
  } else {
    ok(1)
  }
}

def u:linear_fine_tune(path,initial,config,b) {
  "Fine-tune one tiny linear model with manual bounded batch gradients and held-out evidence.";
  u:linear_config(config,b)?;
  bytes=read_bytes(path)?;
  if gt(tally(bytes),b.max_dataset_bytes) {
    err("linear dataset byte budget exceeded")
  } else {
    dataset=parse_json(decode_bytes(bytes),{max_depth: b.max_json_depth,max_bytes: b.max_dataset_bytes,max_elements: b.max_json_elements})?;
    summary=u:adaptation_dataset(dataset,b)?;
    if 1-eq(tally(initial),summary.features+1) {
      err("linear initial parameter count mismatch")
    } else {
      initial_fingerprint=u:adaptation_fingerprint(initial,b)?;
      parameters=initial;
      initial_train_predictions=u:linear_predict(dataset.train.x,summary.features,parameters,b)?;
      initial_train_loss=u:linear_mse(initial_train_predictions,dataset.train.y)?;
      baseline_predictions=u:linear_predict(dataset.evaluation.x,summary.features,parameters,b)?;
      baseline_loss=u:linear_mse(baseline_predictions,dataset.evaluation.y)?;
      losses=concat(fill([0],0),initial_train_loss);
      gradient_norms=fill([0],0);
      updates=0;
      loss=initial_train_loss;
      while lt(updates,config.max_steps)*gt(loss,config.tolerance) {
        if gt(updates,b.max_iterations-1) {
          return err("linear fine-tuning iteration budget exceeded")
        } else {
          0
        };
        step=u:linear_gradient(dataset.train.x,dataset.train.y,summary.features,parameters,b)?;
        gradient_norms=concat(gradient_norms,step.norm);
        parameters=parameters-config.learning_rate*step.gradient;
        if gt(reduce(:max,abs(parameters)),b.max_abs_parameter) {
          return err("linear parameter magnitude budget exceeded")
        } else {
          0
        };
        updates=updates+1;
        predictions=u:linear_predict(dataset.train.x,summary.features,parameters,b)?;
        loss=u:linear_mse(predictions,dataset.train.y)?;
        if (1-eq(loss,loss))+gt(loss,b.max_loss) {
          return err("linear loss is non-finite or over budget")
        } else {
          losses=concat(losses,loss)
        }
      };
      final_fingerprint=u:adaptation_fingerprint(parameters,b)?;
      if equal(initial_fingerprint,final_fingerprint)+lt(updates,1) {
        err("linear fine-tuning did not change parameters")
      } else {
        mode=u:adaptation_mode("fine-tuning",updates,0,0)?;
        held_predictions=u:linear_predict(dataset.evaluation.x,summary.features,parameters,b)?;
        held_loss=u:linear_mse(held_predictions,dataset.evaluation.y)?;
        reason=if lt(loss,config.tolerance)+eq(loss,config.tolerance) {
          "tolerance"
        } else {
          "max_steps"
        };
        report={schema:"sw-ml-study.linear-fine-tuning",version:1,task: summary.task,mode: mode,initial_parameters: initial,final_parameters: parameters,initial_fingerprint: initial_fingerprint,final_fingerprint: final_fingerprint,updates: updates,stopping_reason: reason,learning_rate: config.learning_rate,tolerance: config.tolerance,train:{targets: dataset.train.y,initial_predictions: initial_train_predictions,initial_loss: initial_train_loss,final_predictions: predictions,final_loss: loss,losses: losses,gradient_norms: gradient_norms},evaluation:{targets: dataset.evaluation.y,baseline_predictions: baseline_predictions,baseline_loss: baseline_loss,fine_tuned_predictions: held_predictions,fine_tuned_loss: held_loss},dataset: summary,boundary:{gradient:"manual-mlpl",optimizer:"batch-gradient-descent",native_training:0,external_training:0}};
        json=to_json(report,{tagged:1})?;
        if gt(tally(losses),b.max_curve_points)+gt(tally(tokenize_bytes(json)),b.max_output_bytes) {
          err("linear curve or report output budget exceeded")
        } else {
          decoded=parse_json(json,{max_depth: b.max_json_depth,max_bytes: b.max_output_bytes,max_elements: b.max_json_elements})?;
          if 1-equal(decoded,report) {
            err("linear fine-tuning report round trip changed")
          } else {
            ok({report: report,json: json,utf8_bytes: tally(tokenize_bytes(json))})
          }
        }
      }
    }
  }
}
