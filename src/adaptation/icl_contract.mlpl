include "contract.mlpl";

def u:icl_zero_predict(flat_x,features,parameters,b) { "Apply a frozen linear deployment model without reading context labels."; examples=tally(flat_x)/features; if 1-eq(tally(parameters),features+1)+gt(examples,b.max_query_examples)+gt(examples*features,b.max_query_elements) { err("ICL zero-shot prediction shape or query budget exceeded") } else { predictions=fill([0],0); row=0; while lt(row,examples) { value=take(parameters,0,0); feature=0; while lt(feature,features) { value=value+take(parameters,0,feature+1)*take(flat_x,0,row*features+feature); feature=feature+1 }; if (1-eq(value,value))+gt(abs(value),b.max_abs_prediction) { return err("ICL zero-shot prediction is non-finite or over budget") } else { predictions=concat(predictions,value) }; row=row+1 }; ok(predictions) } }
def u:icl_mse(predictions,targets) { "Compute aligned non-empty baseline mean squared error."; if lt(tally(targets),1)+1-eq(tally(predictions),tally(targets)) { err("ICL baseline vectors are empty or misaligned") } else { errors=predictions-targets; ok(reduce_add(errors*errors)/tally(errors)) } }
def u:icl_record_validate(record,b) { "Validate the versioned renderer-neutral context/query record."; if 1-equal(record_keys(record),["context","provenance","query","schema","version"]) { err("ICL record root schema mismatch") } else { if 1-equal(record.schema,"sw-ml-study.icl-record")+1-eq(record.version,1)+1-equal(record_keys(record.context),["ids","labels","x"])+1-equal(record_keys(record.query),["ids","targets","x"]) { err("ICL record version or split schema mismatch") } else { context=tally(record.context.ids); queries=tally(record.query.ids); if lt(context,1)+gt(context,b.max_context_examples)+lt(queries,1)+gt(queries,b.max_query_examples)+1-eq(tally(record.context.labels),context)+1-eq(tally(record.context.x),context*record.provenance.features)+1-eq(tally(record.query.targets),queries)+1-eq(tally(record.query.x),queries*record.provenance.features) { err("ICL context/query alignment or example budget exceeded") } else { comparisons=0; i=0; while lt(i,context) { j=0; while lt(j,queries) { if gt(comparisons,b.max_context_query_comparisons-1) { return err("ICL context/query comparison budget exceeded") } else { 0 }; if eq(take(record.context.ids,0,i),take(record.query.ids,0,j)) { return err("ICL context/query leakage detected") } else { 0 }; comparisons=comparisons+1; j=j+1 }; i=i+1 }; ok(comparisons) } } } }
def u:icl_contract_report(path,parameters,b) { "Build deterministic ICL context/query and zero-shot evidence with unchanged deployment parameters.";
  bytes=read_bytes(path)?; if gt(tally(bytes),b.max_dataset_bytes) { err("ICL dataset byte budget exceeded") } else {
    dataset=parse_json(decode_bytes(bytes),{max_depth: b.max_json_depth,max_bytes: b.max_dataset_bytes,max_elements: b.max_json_elements})?; summary=u:adaptation_dataset(dataset,b)?; before=u:adaptation_fingerprint(parameters,b)?;
    record={schema:"sw-ml-study.icl-record",version:1,context:{ids: dataset.context.ids,x: dataset.context.x,labels: dataset.context.y},query:{ids: dataset.evaluation.ids,x: dataset.evaluation.x,targets: dataset.evaluation.y},provenance:{dataset: path,task: summary.task,features: summary.features,train_examples: summary.train_examples,context_examples: summary.context_examples,query_examples: summary.evaluation_examples,split_comparisons: summary.split_comparisons}};
    cq=u:icl_record_validate(record,b)?; predictions=u:icl_zero_predict(record.query.x,summary.features,parameters,b)?; loss=u:icl_mse(predictions,record.query.targets)?; after=u:adaptation_fingerprint(parameters,b)?; mode=u:adaptation_mode("icl",0,summary.context_examples,0)?;
    if 1-equal(before,after) { err("ICL deployment parameters changed") } else { report={schema:"sw-ml-study.icl-contract",version:1,record: record,mode: mode,deployment:{parameters: parameters,fingerprint_before: before,fingerprint_after: after,updates:0},zero_shot:{predictions: predictions,targets: record.query.targets,mse: loss,context_labels_used:0},budgets:{context_query_comparisons: cq},boundary:{dataset_io:"native-read_bytes",json:"native-generic-codec",validation:"mlpl",model_training:0,external_model_inference:0}}; json=to_json(report,{tagged:1})?; size=tally(tokenize_bytes(json)); if gt(size,b.max_output_bytes) { err("ICL contract output budget exceeded") } else { decoded=parse_json(json,{max_depth: b.max_json_depth,max_bytes: b.max_output_bytes,max_elements: b.max_json_elements})?; if 1-equal(decoded,report) { err("ICL contract tagged JSON round trip changed") } else { ok({report: report,json: json,utf8_bytes: size}) } } }
  }
}
