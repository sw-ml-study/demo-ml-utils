include "icl_controls.mlpl";

def u:icl_exact_matches(predictions,targets,tolerance) { "Count regression predictions within an explicit absolute tolerance."; if 1-eq(tally(predictions),tally(targets))+lt(tally(targets),1)+lt(tolerance,0) { err("ICL exact-match inputs are invalid") } else { matches=0; index=0; while lt(index,tally(targets)) { if lt(abs(take(predictions,0,index)-take(targets,0,index)),tolerance)+eq(abs(take(predictions,0,index)-take(targets,0,index)),tolerance) { matches=matches+1 } else { 0 }; index=index+1 }; ok(matches) } }
def u:icl_ir_variant(id,context_ids,result,targets,tolerance) { "Normalize one context condition for renderer-neutral comparison."; matches=u:icl_exact_matches(result.predictions,targets,tolerance)?; ok({id: id,context_ids: context_ids,context_count: result.context_count,similarities: result.similarities,contributions: result.contributions,predictions: result.predictions,targets: targets,mse: result.mse,exact_matches: matches,accuracy: matches/tally(targets),association_work: result.association_work}) }
def u:icl_ir_finite(values,limit,b) { "Validate bounded finite comparison evidence, including empty matrices."; flat=flatten(values); if gt(tally(flat),b.max_evidence_elements) { err("ICL comparison evidence element budget exceeded") } else { index=0; while lt(index,tally(flat)) { value=take(flat,0,index); if (1-eq(value,value))+gt(abs(value),limit) { return err("ICL comparison evidence is non-finite or over budget") } else { 0 }; index=index+1 }; ok(tally(flat)) } }
def u:icl_ir_variant_validate(variant,query_count,b) { "Headlessly validate one ICL comparison variant."; if 1-equal(record_keys(variant),["accuracy","association_work","context_count","context_ids","contributions","exact_matches","id","mse","predictions","similarities","targets"]) { err("ICL comparison variant schema mismatch") } else { if 1-eq(tally(variant.context_ids),variant.context_count)+1-eq(tally(variant.predictions),query_count)+1-eq(tally(variant.targets),query_count)+1-equal(shape(variant.similarities),[query_count,variant.context_count])+1-equal(shape(variant.contributions),[query_count,variant.context_count])+lt(variant.exact_matches,0)+gt(variant.exact_matches,query_count)+1-eq(variant.accuracy,variant.exact_matches/query_count)+gt(variant.association_work,b.max_association_work) { err("ICL comparison variant alignment or metric mismatch") } else { u:icl_ir_finite(variant.predictions,b.max_abs_prediction,b)?; u:icl_ir_finite(variant.targets,b.max_abs_prediction,b)?; u:icl_ir_finite(variant.similarities,b.max_abs_similarity,b)?; u:icl_ir_finite(variant.contributions,b.max_abs_contribution,b)?; ok(1) } } }
def u:icl_comparison_validate(ir,b) { "Headlessly validate ICL comparison IR version 1."; if 1-equal(record_keys(ir),["deployment","provenance","query_ids","schema","variants","version"]) { err("ICL comparison root schema mismatch") } else { if 1-equal(ir.schema,"sw-ml-study.icl-comparison-ir")+1-eq(ir.version,1)+1-equal(record_keys(ir.variants),["few_shot","one_shot","zero_shot"])+1-equal(record_keys(ir.provenance),["analyzer","dataset","mechanism","task"]) { err("ICL comparison version, variants, or provenance mismatch") } else { queries=tally(ir.query_ids); if lt(queries,1)+gt(queries,b.max_query_examples)+1-equal(ir.deployment.fingerprint_before,ir.deployment.fingerprint_after)+1-eq(ir.deployment.updates,0) { err("ICL comparison query or frozen deployment invariant failed") } else { u:icl_ir_variant_validate(ir.variants.zero_shot,queries,b)?; u:icl_ir_variant_validate(ir.variants.one_shot,queries,b)?; u:icl_ir_variant_validate(ir.variants.few_shot,queries,b)?; if 1-equal(ir.variants.zero_shot.id,"zero-shot")+1-equal(ir.variants.one_shot.id,"one-shot")+1-equal(ir.variants.few_shot.id,"few-shot") { err("ICL comparison stable variant ID mismatch") } else { ok(1) } } } } }
def u:icl_comparison_ir(path,parameters,tolerance,b) { "Build deterministic renderer-neutral zero/one/few-shot ICL comparison evidence."; source=u:associative_icl_report(path,parameters,b)?; r=source.report; zero=u:icl_ir_variant("zero-shot",fill([0],0),r.zero_shot,r.query.targets,tolerance)?; one=u:icl_ir_variant("one-shot",concat(fill([0],0),take(r.context.ids,0,0)),r.one_shot,r.query.targets,tolerance)?; few=u:icl_ir_variant("few-shot",r.context.ids,r.few_shot,r.query.targets,tolerance)?; deployment={parameters: r.deployment.parameters,fingerprint_before: r.deployment.fingerprint_before,fingerprint_after: r.deployment.fingerprint_after,updates: r.mechanism.parameter_updates}; ir={schema:"sw-ml-study.icl-comparison-ir",version:1,provenance:{analyzer:"mlpl-bounded-icl-comparison",dataset: path,mechanism: r.mechanism.name,task: r.task},deployment: deployment,query_ids: r.query.ids,variants:{zero_shot: zero,one_shot: one,few_shot: few}}; u:icl_comparison_validate(ir,b)?; json=to_json(ir,{tagged:1})?; size=tally(tokenize_bytes(json)); if gt(size,b.max_output_bytes) { err("ICL comparison output budget exceeded") } else { decoded=parse_json(json,{max_depth: b.max_json_depth,max_bytes: b.max_output_bytes,max_elements: b.max_json_elements})?; u:icl_comparison_validate(decoded,b)?; if 1-equal(decoded,ir) { err("ICL comparison tagged JSON round trip changed") } else { ok({ir: ir,json: json,utf8_bytes: size}) } } }
