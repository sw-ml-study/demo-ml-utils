def u:rolling_window(dataset,groups,signal,b) { "Run Split, grouped fit, Feed, and symmetric Ensemble for one window."; split=u:sl_validate(dataset,groups,b)?; parameters=u:sl_fit_all(dataset,groups,b)?; base=u:sl_predict(dataset,parameters,b)?; fed=base+signal; low=fed-1; high=fed+1; aggregate=(low+high)/2; mse=u:sl_mse(aggregate,dataset.evaluation.targets)?; ok({split: split,parameters: parameters,base_predictions: base,fed_signal: signal,fed_predictions: fed,member_low: low,member_high: high,aggregate: aggregate,targets: dataset.evaluation.targets,mse: mse}) }
def u:rolling_ir(w1,w2,b) { "Describe the composed two-window computation with stable named nodes and edges."; nodes={n01:{kind:"input",label:"windowed train/evaluation splits"},n02:{kind:"transform",label:"Split validates provenance"},n03:{kind:"transform",label:"Lift-like grouped fit"},n04:{kind:"artifact",label:"per-group offsets",window_1: w1.parameters.offsets,window_2: w2.parameters.offsets},n05:{kind:"transform",label:"Feed adds window signal",window_1: w1.fed_signal,window_2: w2.fed_signal},n06:{kind:"transform",label:"Ensemble symmetric members"},n07:{kind:"metric",label:"held-out MSE",window_1: w1.mse,window_2: w2.mse}}; edges={e01:{from:"n01",to:"n02"},e02:{from:"n02",to:"n03"},e03:{from:"n03",to:"n04"},e04:{from:"n04",to:"n05"},e05:{from:"n05",to:"n06"},e06:{from:"n06",to:"n07"}}; ir={schema:"sw-ml-study.composable-experiment",version:1,nodes: nodes,edges: edges,outputs:{window_1: w1.aggregate,window_2: w2.aggregate},provenance:{window_1_train_ids:[101,102,201,202],window_1_evaluation_ids:[103,203],window_2_train_ids:[111,112,211,212],window_2_evaluation_ids:[113,213]},budgets:{max_nodes: b.max_nodes,max_edges: b.max_edges,max_output_bytes: b.max_output_bytes}}; u:rolling_validate_ir(ir,b)?; ok(ir) }
def u:rolling_validate_ir(ir,b) { "Independently validate schema, stable topology, counts, and encoded size."; if 1-equal(record_keys(ir),["budgets","edges","nodes","outputs","provenance","schema","version"])+1-equal(ir.schema,"sw-ml-study.composable-experiment")+1-eq(ir.version,1) { err("rolling IR schema mismatch") } else { node_keys=record_keys(ir.nodes); edge_keys=record_keys(ir.edges); if gt(7,b.max_nodes)+gt(6,b.max_edges)+1-equal(node_keys,["n01","n02","n03","n04","n05","n06","n07"])+1-equal(edge_keys,["e01","e02","e03","e04","e05","e06"]) { err("rolling IR topology or count budget mismatch") } else { encoded=to_json(ir,{tagged:1})?; if gt(tally(tokenize_bytes(encoded)),b.max_output_bytes) { err("rolling IR output budget exceeded") } else { ok({nodes: 7,edges: 6,bytes: tally(tokenize_bytes(encoded))}) } } } }
def u:rolling_report(d1,d2,b) { "Compare explicit arithmetic with the factored two-window computation and publish its IR."; groups=[1,2]; w1=u:rolling_window(d1,groups,1,b)?; w2=u:rolling_window(d2,groups,2,b)?; explicit_1=[10+2+1,10+8+1]; explicit_2=[20+3+2,20+9+2]; ir=u:rolling_ir(w1,w2,b)?; encoded=to_json(ir,{tagged:1})?; decoded=parse_json(encoded,{max_depth:12,max_bytes: b.max_output_bytes,max_elements:256})?; validation=u:rolling_validate_ir(decoded,b)?; ok({windows:{window_1: w1,window_2: w2},explicit:{window_1: explicit_1,window_2: explicit_2},parity: equal(explicit_1,w1.aggregate)*equal(explicit_2,w2.aggregate),ir: ir,independent_validation: validation,round_trip: equal(decoded,ir),blockers:[]}) }
