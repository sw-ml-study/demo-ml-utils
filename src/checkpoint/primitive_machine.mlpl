include "passive_inventory.mlpl";

def u:primitive_push(stack,value,b) {
  "Push one node id while enforcing the operand-stack budget.";
  if gt(tally(stack),b.max_stack-1) {
    err("pickle operand stack budget exceeded")
  } else {
    ok(concat(stack,value))
  }
}
def u:primitive_pop(stack,count) {
  "Remove a fixed number of operands from the numeric stack.";
  if gt(count,tally(stack)) {
    err("pickle operand stack underflow")
  } else {
    ok(compress(lt(range(tally(stack)),tally(stack)-count),stack))
  }
}
def u:primitive_memo_get(indices,values,key) {
  "Resolve only an already-created inert node id from the bounded numeric memo.";
  found=-1;
  index=0;
  while lt(index,tally(indices)) {
    if eq(take(indices,0,index),key) {
      found=take(values,0,index)
    } else {
      0
    };
    index=index+1
  };
  if lt(found,0) {
    err("pickle memo reference is missing")
  } else {
    ok(found)
  }
}
def u:primitive_add_node(types,numbers,text,lengths,kind,number,bytes,b) {
  "Append one inert typed node to fixed-width columnar storage.";
  if gt(tally(types),b.max_nodes-1)+gt(tally(bytes),b.max_string_bytes)+gt(tally(text)+b.max_string_bytes,b.max_nodes*b.max_string_bytes) {
    err("pickle node or string-width budget exceeded")
  } else {
    ok({id: tally(types),types: concat(types,kind),numbers: concat(numbers,number),text: concat(text,concat(bytes,fill([b.max_string_bytes-tally(bytes)],0))),lengths: concat(lengths,tally(bytes))})
  }
}
def u:primitive_text(machine,node) {
  "Decode one bounded string node from the evaluator's inert value graph.";
  if lt(node,0)+gt(node,tally(machine.node_types)-1)+1-eq(take(machine.node_types,0,node),3) {
    err("pickle node is not bounded text")
  } else {
    row=take(reshape(machine.node_text,[tally(machine.node_types),machine.string_width]),0,node);
    ok(decode_bytes(compress(lt(range(machine.string_width),take(machine.node_text_lengths,0,node)),row)))
  }
}
def u:primitive_list_numbers(machine,node) {
  "Project numeric children from one list node for a readable demonstration.";
  values=fill([0],0);
  index=0;
  while lt(index,tally(machine.list_parents)) {
    if eq(take(machine.list_parents,0,index),node) {
      child=take(machine.list_values,0,index);
      if 1-eq(take(machine.node_types,0,child),4) {
        return err("pickle list child is not numeric")
      } else {
        values=concat(values,take(machine.node_numbers,0,child))
      }
    } else {
      0
    };
    index=index+1
  };
  ok(values)
}

def u:primitive_pickle_machine(bytes,b) {
  "Evaluate only an explicit primitive pickle opcode allow-list into an inert value graph.";
  inventory=u:passive_pickle_inventory(bytes,b)?;
  if gt(inventory.dangerous_opcodes,0) {
    err("pickle executable or persistence opcode rejected")
  } else {
    cursor=0;
    opcodes=0;
    stopped=0;
    stack=fill([0],0);
    marks=0;
    memo_indices=fill([0],0);
    memo_values=fill([0],0);
    types=fill([0],0);
    numbers=fill([0],0);
    text=fill([0],0);
    lengths=fill([0],0);
    total_string_bytes=0;
    list_parents=fill([0],0);
    list_positions=fill([0],0);
    list_values=fill([0],0);
    dict_parents=fill([0],0);
    dict_keys=fill([0],0);
    dict_values=fill([0],0);
    while lt(cursor,tally(bytes))*(1-stopped) {
      if gt(opcodes,b.max_opcodes-1)+gt(opcodes,b.max_iterations-1) {
        return err("pickle opcode or iteration budget exceeded")
      } else {
        0
      };
      opcode=take(bytes,0,cursor);
      cursor=cursor+1;
      opcodes=opcodes+1;
      if eq(opcode,128) {
        protocol=u:checkpoint_u(bytes,cursor,1)?;
        cursor=cursor+1;
        if gt(protocol,5) {
          return err("pickle protocol is unsupported")
        } else {
          0
        }
      } else {
        if eq(opcode,46) {
          if 1-eq(tally(stack),1)+gt(marks,0) {
            return err("pickle STOP requires exactly one unmarked root")
          } else {
            stopped=1
          }
        } else {
          if eq(opcode,125)+eq(opcode,93)+eq(opcode,78)+eq(opcode,136)+eq(opcode,137) {
            kind=if eq(opcode,125) {
              1
            } else {
              if eq(opcode,93) {
                2
              } else {
                if eq(opcode,78) {
                  5
                } else {
                  4
                }
              }
            };
            number=if eq(opcode,137) {
              1
            } else {
              0
            };
            node=u:primitive_add_node(types,numbers,text,lengths,kind,number,fill([0],0),b)?;
            types=node.types;
            numbers=node.numbers;
            text=node.text;
            lengths=node.lengths;
            stack=u:primitive_push(stack,node.id,b)?
          } else {
            if eq(opcode,75)+eq(opcode,77)+eq(opcode,74) {
              width=if eq(opcode,75) {
                1
              } else {
                if eq(opcode,77) {
                  2
                } else {
                  4
                }
              };
              number=u:checkpoint_u(bytes,cursor,width)?;
              cursor=cursor+width;
              if eq(opcode,74)*gt(number,2147483647) {
                number=number-4294967296
              } else {
                0
              };
              node=u:primitive_add_node(types,numbers,text,lengths,4,number,fill([0],0),b)?;
              types=node.types;
              numbers=node.numbers;
              text=node.text;
              lengths=node.lengths;
              stack=u:primitive_push(stack,node.id,b)?
            } else {
              if eq(opcode,88)+eq(opcode,140) {
                width=if eq(opcode,88) {
                  4
                } else {
                  1
                };
                count=u:checkpoint_u(bytes,cursor,width)?;
                cursor=cursor+width;
                if gt(count,b.max_string_bytes)+gt(total_string_bytes+count,b.max_total_string_bytes)+gt(cursor+count,tally(bytes)) {
                  return err("pickle string byte or truncation budget exceeded")
                } else {
                  0
                };
                string_bytes=fill([0],0);
                copied=0;
                while lt(copied,count) {
                  string_bytes=concat(string_bytes,take(bytes,0,cursor+copied));
                  copied=copied+1
                };
                cursor=cursor+count;
                total_string_bytes=total_string_bytes+count;
                node=u:primitive_add_node(types,numbers,text,lengths,3,0,string_bytes,b)?;
                types=node.types;
                numbers=node.numbers;
                text=node.text;
                lengths=node.lengths;
                stack=u:primitive_push(stack,node.id,b)?
              } else {
                if eq(opcode,40) {
                  if gt(marks,b.max_depth-1) {
                    return err("pickle mark depth budget exceeded")
                  } else {
                    stack=u:primitive_push(stack,-1,b)?;
                    marks=marks+1
                  }
                } else {
                  if eq(opcode,113)+eq(opcode,114) {
                    width=if eq(opcode,113) {
                      1
                    } else {
                      4
                    };
                    key=u:checkpoint_u(bytes,cursor,width)?;
                    cursor=cursor+width;
                    if eq(tally(stack),0)+gt(tally(memo_indices),b.max_memo_entries-1) {
                      return err("pickle memo store budget or stack failure")
                    } else {
                      0
                    };
                    prior=0;
                    scan=0;
                    while lt(scan,tally(memo_indices)) {
                      prior=prior+eq(take(memo_indices,0,scan),key);
                      scan=scan+1
                    };
                    if gt(prior,0) {
                      return err("pickle memo index redefinition rejected")
                    } else {
                      memo_indices=concat(memo_indices,key);
                      memo_values=concat(memo_values,take(stack,0,tally(stack)-1))
                    }
                  } else {
                    if eq(opcode,104)+eq(opcode,106) {
                      width=if eq(opcode,104) {
                        1
                      } else {
                        4
                      };
                      key=u:checkpoint_u(bytes,cursor,width)?;
                      cursor=cursor+width;
                      value=u:primitive_memo_get(memo_indices,memo_values,key)?;
                      stack=u:primitive_push(stack,value,b)?
                    } else {
                      if eq(opcode,97) {
                        if lt(tally(stack),2) {
                          return err("pickle APPEND stack underflow")
                        } else {
                          parent=take(stack,0,tally(stack)-2);
                          value=take(stack,0,tally(stack)-1);
                          if 1-eq(take(types,0,parent),2)+gt(tally(list_values),b.max_list_items-1) {
                            return err("pickle APPEND target or item budget failure")
                          } else {
                            position=0;
                            scan=0;
                            while lt(scan,tally(list_parents)) {
                              position=position+eq(take(list_parents,0,scan),parent);
                              scan=scan+1
                            };
                            list_parents=concat(list_parents,parent);
                            list_positions=concat(list_positions,position);
                            list_values=concat(list_values,value);
                            stack=u:primitive_pop(stack,1)?
                          }
                        }
                      } else {
                        if eq(opcode,101) {
                          mark=tally(stack)-1;
                          while gt(mark,-1)*1-eq(take(stack,0,mark),-1) {
                            mark=mark-1
                          };
                          if lt(mark,1) {
                            return err("pickle APPENDS mark underflow")
                          } else {
                            parent=take(stack,0,mark-1);
                            if 1-eq(take(types,0,parent),2)+gt(tally(list_values)+tally(stack)-mark-1,b.max_list_items) {
                              return err("pickle APPENDS target or item budget failure")
                            } else {
                              position=0;
                              scan=0;
                              while lt(scan,tally(list_parents)) {
                                position=position+eq(take(list_parents,0,scan),parent);
                                scan=scan+1
                              };
                              item=mark+1;
                              while lt(item,tally(stack)) {
                                list_parents=concat(list_parents,parent);
                                list_positions=concat(list_positions,position);
                                list_values=concat(list_values,take(stack,0,item));
                                position=position+1;
                                item=item+1
                              };
                              stack=compress(lt(range(tally(stack)),mark),stack);
                              marks=marks-1
                            }
                          }
                        } else {
                          if eq(opcode,115) {
                            if lt(tally(stack),3) {
                              return err("pickle SETITEM stack underflow")
                            } else {
                              parent=take(stack,0,tally(stack)-3);
                              key=take(stack,0,tally(stack)-2);
                              value=take(stack,0,tally(stack)-1);
                              if 1-eq(take(types,0,parent),1)+gt(tally(dict_values),b.max_dict_items-1) {
                                return err("pickle SETITEM target or item budget failure")
                              } else {
                                dict_parents=concat(dict_parents,parent);
                                dict_keys=concat(dict_keys,key);
                                dict_values=concat(dict_values,value);
                                stack=u:primitive_pop(stack,2)?
                              }
                            }
                          } else {
                            return err("pickle opcode is outside the primitive evaluator allow-list")
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    };
    if 1-stopped {
      err("pickle STOP is missing")
    } else {
      machine={schema:"sw-ml-study.pickle-primitives",version:1,root: take(stack,0,0),node_types: types,node_numbers: numbers,node_text: text,node_text_lengths: lengths,string_width: b.max_string_bytes,list_parents: list_parents,list_positions: list_positions,list_values: list_values,dict_parents: dict_parents,dict_keys: dict_keys,dict_values: dict_values,memo_indices: memo_indices,memo_values: memo_values,opcode_count: opcodes,safety:{global_resolution:0,callable_invocation:0,object_construction:0,persistence_resolution:0}};
      json=to_json(machine,{tagged:1})?;
      if gt(tally(tokenize_bytes(json)),b.max_output_bytes) {
        err("pickle evaluator output byte budget exceeded")
      } else {
        decoded=parse_json(json,{max_depth: b.max_json_depth,max_bytes: b.max_output_bytes,max_elements: b.max_json_elements})?;
        if 1-equal(decoded,machine) {
          err("pickle evaluator graph round trip changed")
        } else {
          ok({machine: machine,json: json,utf8_bytes: tally(tokenize_bytes(json)),inventory: inventory})
        }
      }
    }
  }
}

def u:checkpoint_primitive_machine(path,b) {
  "Validate a single stored data.pkl container, then evaluate its bytes with the primitive machine.";
  u:checkpoint_inventory(path,b)?;
  size=file_size(path)?;
  bytes=read_bytes(path,0,size)?;
  name_length=u:checkpoint_u(bytes,26,2)?;
  compressed=u:checkpoint_u(bytes,18,4)?;
  start=30+name_length;
  pickle=fill([0],0);
  copied=0;
  while lt(copied,compressed) {
    pickle=concat(pickle,take(bytes,0,start+copied));
    copied=copied+1
  };
  u:primitive_pickle_machine(pickle,b)
}
