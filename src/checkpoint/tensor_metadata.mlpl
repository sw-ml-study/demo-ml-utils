include "primitive_machine.mlpl";

def u:tensor_dict_value(machine,parent,name) {
  "Resolve exactly one bounded text-keyed edge from an inert dictionary node.";
  found=-1;
  matches=0;
  index=0;
  while lt(index,tally(machine.dict_parents)) {
    if eq(take(machine.dict_parents,0,index),parent) {
      key=take(machine.dict_keys,0,index);
      if eq(take(machine.node_types,0,key),3) {
        text=u:primitive_text(machine,key)?;
        if equal(text,name) {
          found=take(machine.dict_values,0,index);
          matches=matches+1
        } else {
          0
        }
      } else {
        0
      }
    } else {
      0
    };
    index=index+1
  };
  if 1-eq(matches,1) {
    err("tensor metadata field is missing or duplicate")
  } else {
    ok(found)
  }
}
def u:tensor_number(machine,node) {
  "Read one inert integer node.";
  if lt(node,0)+gt(node,tally(machine.node_types)-1)+1-eq(take(machine.node_types,0,node),4) {
    err("tensor metadata value is not an integer")
  } else {
    ok(take(machine.node_numbers,0,node))
  }
}
def u:tensor_text(machine,node) {
  "Read one inert bounded-text node.";
  u:primitive_text(machine,node)
}
def u:tensor_list_shape(machine,node,b) {
  "Recover one positive bounded integer shape from list edges.";
  if lt(node,0)+gt(node,tally(machine.node_types)-1)+1-eq(take(machine.node_types,0,node),2) {
    err("tensor shape is not a primitive list")
  } else {
    shape=fill([0],0);
    product=1;
    index=0;
    while lt(index,tally(machine.list_parents)) {
      if eq(take(machine.list_parents,0,index),node) {
        dimension=u:tensor_number(machine,take(machine.list_values,0,index))?;
        if lt(dimension,1)+gt(tally(shape),b.max_rank-1)+gt(product,b.max_parameters/dimension) {
          return err("tensor shape rank, dimension, or parameter budget exceeded")
        } else {
          shape=concat(shape,dimension);
          product=product*dimension
        }
      } else {
        0
      };
      index=index+1
    };
    if eq(tally(shape),0) {
      err("tensor shape cannot be empty")
    } else {
      ok({shape: shape,parameters: product})
    }
  }
}

def u:checkpoint_member_catalog(path,b) {
  "Return bounded local-member names and byte ranges after full ZIP directory validation.";
  u:checkpoint_multi_inventory(path,b)?;
  size=file_size(path)?;
  bytes=read_bytes(path,0,size)?;
  cursor=0;
  count=0;
  names=fill([0],0);
  lengths=fill([0],0);
  data_offsets=fill([0],0);
  byte_counts=fill([0],0);
  pickle=fill([0],0);
  while u:checkpoint_signature(bytes,cursor,[80,75,3,4]) {
    if gt(count,b.max_members-1)+gt(count,b.max_iterations-1) {
      return err("checkpoint member catalog budget exceeded")
    } else {
      0
    };
    compressed=u:checkpoint_u(bytes,cursor+18,4)?;
    name_length=u:checkpoint_u(bytes,cursor+26,2)?;
    extra_length=u:checkpoint_u(bytes,cursor+28,2)?;
    start=cursor+30+name_length+extra_length;
    finish=start+compressed;
    name_bytes=fill([0],0);
    copied=0;
    while lt(copied,name_length) {
      name_bytes=concat(name_bytes,take(bytes,0,cursor+30+copied));
      copied=copied+1
    };
    appended=u:checkpoint_append_name(name_bytes,names,lengths,b.max_string_bytes)?;
    names=appended.table;
    lengths=appended.lengths;
    data_offsets=concat(data_offsets,start);
    byte_counts=concat(byte_counts,compressed);
    if equal(decode_bytes(name_bytes),"data.pkl") {
      copied=0;
      while lt(copied,compressed) {
        pickle=concat(pickle,take(bytes,0,start+copied));
        copied=copied+1
      }
    } else {
      0
    };
    count=count+1;
    cursor=finish
  };
  ok({artifact_bytes: size,member_count: count,name_bytes: names,name_lengths: lengths,data_offsets: data_offsets,byte_counts: byte_counts,pickle_bytes: pickle,string_width: b.max_string_bytes})
}
def u:checkpoint_member_index(catalog,name) {
  "Resolve exactly one ZIP member by its validated safe name.";
  found=-1;
  matches=0;
  index=0;
  while lt(index,catalog.member_count) {
    row=take(reshape(catalog.name_bytes,[catalog.member_count,catalog.string_width]),0,index);
    text=decode_bytes(compress(lt(range(catalog.string_width),take(catalog.name_lengths,0,index)),row));
    if equal(text,name) {
      found=index;
      matches=matches+1
    } else {
      0
    };
    index=index+1
  };
  if 1-eq(matches,1) {
    err("tensor storage member is missing or duplicate")
  } else {
    ok(found)
  }
}
def u:tensor_catalog_text(report,index,field) {
  "Decode one fixed-width tensor or storage name from a recovery report.";
  table=if equal(field,"tensor") {
    report.tensor_name_bytes
  } else {
    report.storage_name_bytes
  };
  lengths=if equal(field,"tensor") {
    report.tensor_name_lengths
  } else {
    report.storage_name_lengths
  };
  row=take(reshape(table,[report.tensor_count,report.string_width]),0,index);
  decode_bytes(compress(lt(range(report.string_width),take(lengths,0,index)),row))
}

def u:checkpoint_tensor_metadata(path,b) {
  "Recover declarative tensor metadata and validated storage ranges without resolving pickle executable constructs.";
  members=u:checkpoint_member_catalog(path,b)?;
  machine_result=u:primitive_pickle_machine(members.pickle_bytes,b)?;
  machine=machine_result.machine;
  root=machine.root;
  if 1-eq(take(machine.node_types,0,root),1) {
    err("tensor metadata root must be a primitive dictionary")
  } else {
    tensor_names=fill([0],0);
    tensor_name_lengths=fill([0],0);
    storage_names=fill([0],0);
    storage_name_lengths=fill([0],0);
    dtypes=fill([0],0);
    ranks=fill([0],0);
    shapes=fill([0],0);
    parameters=fill([0],0);
    storage_member_indices=fill([0],0);
    storage_file_offsets=fill([0],0);
    storage_offsets=fill([0],0);
    byte_counts=fill([0],0);
    tensors=0;
    edge=0;
    while lt(edge,tally(machine.dict_parents)) {
      if eq(take(machine.dict_parents,0,edge),root) {
        if gt(tensors,b.max_tensors-1)+gt(tensors,b.max_iterations-1) {
          return err("tensor count or iteration budget exceeded")
        } else {
          0
        };
        name_node=take(machine.dict_keys,0,edge);
        descriptor=take(machine.dict_values,0,edge);
        name=u:tensor_text(machine,name_node)?;
        name_bytes=tokenize_bytes(name);
        if 1-u:checkpoint_name_safe(name_bytes)+u:checkpoint_prior_name(name_bytes,tensor_names,tensor_name_lengths,tensors,b.max_string_bytes)+1-eq(take(machine.node_types,0,descriptor),1) {
          return err("tensor name or descriptor policy failure")
        } else {
          0
        };
        fields=0;
        scan=0;
        while lt(scan,tally(machine.dict_parents)) {
          fields=fields+eq(take(machine.dict_parents,0,scan),descriptor);
          scan=scan+1
        };
        if 1-eq(fields,5) {
          return err("tensor descriptor requires exactly five fields")
        } else {
          0
        };
        storage=u:tensor_text(machine,u:tensor_dict_value(machine,descriptor,"storage")?)?;
        dtype=u:tensor_text(machine,u:tensor_dict_value(machine,descriptor,"dtype")?)?;
        shaped=u:tensor_list_shape(machine,u:tensor_dict_value(machine,descriptor,"shape")?,b)?;
        offset=u:tensor_number(machine,u:tensor_dict_value(machine,descriptor,"offset")?)?;
        length=u:tensor_number(machine,u:tensor_dict_value(machine,descriptor,"length")?)?;
        width=if equal(dtype,"I8") {
          1
        } else {
          if equal(dtype,"I16") {
            2
          } else {
            return err("tensor dtype is outside the storage-recovery allow-list")
          }
        };
        if lt(offset,0)+lt(length,1)+1-eq(length,shaped.parameters*width)+gt(length,b.max_storage_bytes) {
          return err("tensor storage length, dtype, or parameter mismatch")
        } else {
          0
        };
        member=u:checkpoint_member_index(members,storage)?;
        if equal(storage,"data.pkl")+gt(offset+length,take(members.byte_counts,0,member)) {
          return err("tensor storage range is invalid or targets metadata")
        } else {
          0
        };
        appended=u:checkpoint_append_name(name_bytes,tensor_names,tensor_name_lengths,b.max_string_bytes)?;
        tensor_names=appended.table;
        tensor_name_lengths=appended.lengths;
        storage_bytes=tokenize_bytes(storage);
        appended_storage=u:checkpoint_append_name(storage_bytes,storage_names,storage_name_lengths,b.max_string_bytes)?;
        storage_names=appended_storage.table;
        storage_name_lengths=appended_storage.lengths;
        dtypes=concat(dtypes,if equal(dtype,"I8") {
            1
          } else {
            2
          });
        ranks=concat(ranks,tally(shaped.shape));
        shapes=concat(shapes,concat(shaped.shape,fill([b.max_rank-tally(shaped.shape)],0)));
        parameters=concat(parameters,shaped.parameters);
        storage_member_indices=concat(storage_member_indices,member);
        storage_file_offsets=concat(storage_file_offsets,take(members.data_offsets,0,member)+offset);
        storage_offsets=concat(storage_offsets,offset);
        byte_counts=concat(byte_counts,length);
        tensors=tensors+1
      } else {
        0
      };
      edge=edge+1
    };
    report={schema:"sw-ml-study.checkpoint-tensor-metadata",version:1,tensor_count: tensors,tensor_name_bytes: tensor_names,tensor_name_lengths: tensor_name_lengths,storage_name_bytes: storage_names,storage_name_lengths: storage_name_lengths,string_width: b.max_string_bytes,dtype_ids: dtypes,ranks: ranks,shapes: shapes,shape_width: b.max_rank,parameters: parameters,storage_member_indices: storage_member_indices,storage_file_offsets: storage_file_offsets,storage_offsets: storage_offsets,byte_counts: byte_counts,artifact_bytes: members.artifact_bytes,member_count: members.member_count,safety:{global_resolution:0,callable_invocation:0,object_construction:0,extension_resolution:0,persistence_resolution:0,storage_bytes_read:0}};
    json=to_json(report,{tagged:1})?;
    if gt(tally(tokenize_bytes(json)),b.max_output_bytes) {
      err("tensor metadata report output budget exceeded")
    } else {
      decoded=parse_json(json,{max_depth: b.max_json_depth,max_bytes: b.max_output_bytes,max_elements: b.max_json_elements})?;
      if 1-equal(decoded,report) {
        err("tensor metadata report round trip changed")
      } else {
        ok({report: report,json: json,utf8_bytes: tally(tokenize_bytes(json)),machine: machine,members: members})
      }
    }
  }
}
