include "../formats/safetensors_slice.mlpl";
include "../formats/gguf_slice.mlpl";

def u:writer_uint(value,width,maximum) { "Encode one bounded exact unsigned integer little-endian.";
  if (1-eq(rank(value),0))+(1-eq(value,floor(value)))+lt(value,0)+gt(value,maximum) { err("writer integer is outside its exact budget") } else { output=fill([0],0); remaining=value; index=0; while lt(index,width) { output=concat(output,mod(remaining,256)); remaining=floor(remaining/256); index=index+1 }; if gt(remaining,0) { err("writer integer does not fit its field width") } else { ok(output) } }
}
def u:writer_string(value,max_string_bytes) { "Encode one GGUF length-prefixed UTF-8 string.";
  if 1-equal(type_of(value),"string") { err("writer string must be text") } else { bytes=tokenize_bytes(value); if lt(tally(bytes),1)+gt(tally(bytes),max_string_bytes) { err("writer string byte budget exceeded") } else { ok(concat(u:writer_uint(tally(bytes),8,9007199254740991)?,bytes)) } }
}
def u:writer_tensor_type(dtype) { "Map the supported signed Safetensors integer subset to GGUF type IDs."; if equal(dtype,"I8") { ok(24) } else { if equal(dtype,"I16") { ok(25) } else { err("writer supports only I8 and I16 tensors") } } }
def u:build_single_tensor_gguf(input_path,name,b) { "Build one bounded deterministic rank-one GGUF v3 artifact entirely in MLPL.";
  descriptor=u:safetensors_tensor_descriptor(input_path,name,b.max_header_bytes,b.max_json_elements,b.max_parameters)?; if (1-eq(tally(descriptor.shape),1))+gt(descriptor.byte_count,b.max_payload_bytes)+lt(b.max_tensors,1)+lt(b.max_metadata,2)+lt(b.max_iterations,1) { err("writer tensor shape or resource budget exceeded") } else { type_id=u:writer_tensor_type(descriptor.dtype)?; payload=read_bytes(input_path,descriptor.file_offset,descriptor.byte_count)?; if 1-eq(tally(payload),descriptor.byte_count) { err("writer source payload read was short") } else { magic=[71,71,85,70]; header=concat(magic,u:writer_uint(3,4,3)?); header=concat(header,u:writer_uint(1,8,b.max_tensors)?); header=concat(header,u:writer_uint(2,8,b.max_metadata)?); header=concat(header,u:writer_string("general.architecture",b.max_string_bytes)?); header=concat(header,u:writer_uint(8,4,12)?); header=concat(header,u:writer_string("demo",b.max_string_bytes)?); header=concat(header,u:writer_string("general.alignment",b.max_string_bytes)?); header=concat(header,u:writer_uint(4,4,12)?); header=concat(header,u:writer_uint(32,4,4294967295)?); header=concat(header,u:writer_string(name,b.max_string_bytes)?); header=concat(header,u:writer_uint(1,4,b.max_rank)?); header=concat(header,u:writer_uint(take(descriptor.shape,0,0),8,b.max_parameters)?); header=concat(header,u:writer_uint(type_id,4,39)?); header=concat(header,u:writer_uint(0,8,9007199254740991)?); padding=mod(32-mod(tally(header),32),32); bytes=concat(header,concat(fill([padding],0),payload)); if gt(tally(bytes),b.max_output_bytes) { err("writer output byte budget exceeded") } else { source=u:read_safetensors_tensor(input_path,name,b.max_header_bytes,b.max_json_elements,b.max_parameters,b.max_payload_bytes)?; ok({bytes: bytes,catalog_bytes: tally(header)+padding,payload_bytes: tally(payload),type_id: type_id,shape: descriptor.shape,source_values: source.values}) } } }
}
def u:write_single_tensor_gguf(input_path,name,output_path,b) { "Atomically write and self-validate one bounded Safetensors-to-GGUF conversion.";
  built=u:build_single_tensor_gguf(input_path,name,b)?; write_atomic(output_path,built.bytes)?; catalog=u:catalog_gguf(output_path,b.max_output_bytes,b.max_metadata,b.max_tensors,b.max_string_bytes,b.max_rank,b.max_parameters)?; decoded=u:read_gguf_tensor(output_path,name,b.max_output_bytes,b.max_metadata,b.max_tensors,b.max_string_bytes,b.max_rank,b.max_parameters,b.max_payload_bytes)?; if (1-eq(catalog.tensor_count,1))+(1-eq(catalog.metadata_count,2))+(1-eq(catalog.catalog_bytes,built.catalog_bytes))+(1-eq(decoded.type_id,built.type_id))+(1-equal(decoded.values,built.source_values)) { err("writer read-back validation mismatch") } else { ok({path: output_path,file_bytes: file_size(output_path)?,catalog_bytes: catalog.catalog_bytes,payload_bytes: decoded.byte_count,type_id: decoded.type_id,shape: built.shape,values: decoded.values,atomic_write:1,self_validated:1}) }
}
