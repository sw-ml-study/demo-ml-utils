include "quantization_error_tiles.mlpl";

def u:transport_concat(left,right) { "Concatenate transport text without native formatting."; decode_bytes(concat(tokenize_bytes(left),tokenize_bytes(right))) }
def u:transport_kind(kind) { "Map a message kind to required LOD and payload schema.";
  if equal(kind,"scene") { ok({lod:0,schema:"sw-ml-study.scene-tiles",objects:10}) } else { if equal(kind,"tensor-city") { ok({lod:1,schema:"sw-ml-study.tensor-city",objects:12}) } else { if equal(kind,"detail") { ok({lod:2,schema:"sw-ml-study.distribution-surfaces",objects:5}) } else { if equal(kind,"quantization-error") { ok({lod:3,schema:"sw-ml-study.q8-error-tile",objects:4}) } else { err("unknown visualization transport kind") } } } }
}
def u:transport_validate(envelope,b) { "Fail closed on an encoded visualization transport envelope.";
  if 1 - equal(record_keys(envelope),["kind","lod","object_count","payload_bytes","payload_json","provenance","schema","sequence","version"]) { err("transport envelope schema mismatch") } else { policy = u:transport_kind(envelope.kind)?;
  if (1 - equal(envelope.schema,"sw-ml-study.visualization-message")) + (1 - eq(envelope.version,1)) + (1 - eq(envelope.lod,policy.lod)) + (1 - eq(envelope.object_count,policy.objects)) + gt(envelope.object_count,b.max_objects) + gt(envelope.lod,b.max_lod) + gt(envelope.sequence,b.max_sequence) { err("transport envelope policy mismatch") } else {
  if (1 - equal(type_of(envelope.provenance),"string")) + gt(tally(tokenize_bytes(envelope.provenance)),b.max_label_bytes) + (1 - eq(tally(tokenize_bytes(envelope.payload_json)),envelope.payload_bytes)) + gt(envelope.payload_bytes,b.max_payload_bytes) { err("transport provenance or payload budget mismatch") } else {
  payload = parse_json(envelope.payload_json,{max_depth: b.max_json_depth,max_bytes: b.max_payload_bytes,max_elements: b.max_json_elements})?; if 1 - equal(record_get(payload,"schema")?,policy.schema) { err("transport payload schema does not match message kind") } else { ok(1) }
  } } }
}
def u:transport_message(kind,sequence,provenance,payload_json,b) { "Build and round-trip one deterministic visualization message.";
  policy = u:transport_kind(kind)?; envelope = {schema:"sw-ml-study.visualization-message",version:1,kind: kind,sequence: sequence,lod: policy.lod,provenance: provenance,object_count: policy.objects,payload_bytes: tally(tokenize_bytes(payload_json)),payload_json: payload_json}; u:transport_validate(envelope,b)?; json = to_json(envelope)?; if gt(tally(tokenize_bytes(json)),b.max_message_bytes) { err("transport encoded message budget exceeded") } else { decoded = parse_json(json,{max_depth: b.max_json_depth+2,max_bytes: b.max_message_bytes,max_elements: b.max_json_elements+16})?; u:transport_validate(decoded,b)?; if 1-equal(decoded,envelope) { err("transport message round trip changed envelope") } else { ok({envelope: envelope,json: json,bytes: tally(tokenize_bytes(json))}) } }
}
def u:transport_bundle(scene_json,city_json,detail_json,error_json,b) { "Build an ordered four-message JSONL visualization bundle.";
  if lt(b.max_messages,4) + lt(b.max_iterations,4) { err("transport message or iteration budget exceeded") } else { m0=u:transport_message("scene",0,"bounded-scene",scene_json,b)?; m1=u:transport_message("tensor-city",1,"bounded-catalogs",city_json,b)?; m2=u:transport_message("detail",2,"bounded-selected-tensors",detail_json,b)?; m3=u:transport_message("quantization-error",3,"bounded-q8-reference",error_json,b)?; line0=u:transport_concat(m0.json,"\n"); line1=u:transport_concat(m1.json,"\n"); line2=u:transport_concat(m2.json,"\n"); jsonl=u:transport_concat(u:transport_concat(line0,line1),u:transport_concat(line2,m3.json)); bytes=tally(tokenize_bytes(jsonl)); if gt(bytes,b.max_total_bytes) { err("transport JSONL total budget exceeded") } else { ok({jsonl: jsonl,bytes: bytes,messages:4,sequences:[0,1,2,3],lods:[0,1,2,3],message_bytes:[m0.bytes,m1.bytes,m2.bytes,m3.bytes]}) } }
}
